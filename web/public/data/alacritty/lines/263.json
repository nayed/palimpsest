 = event_tx.send(ChildEvent::Exited);","}","","pub struct ChildExitWatcher {","    wait_handle: AtomicPtr<c_void>,","    event_rx: Receiver<ChildEvent>,","}","","impl ChildExitWatcher {","    pub fn new(child_handle: HANDLE) -> Result<ChildExitWatcher, Error> {","        let (event_tx, event_rx) = channel::<ChildEvent>();","","        let mut wait_handle: HANDLE = 0 as HANDLE;","        let sender_ref = Box::new(event_tx);","","        let success = unsafe {","            RegisterWaitForSingleObject(","                &mut wait_handle,","                child_handle,","                Some(child_exit_callback),","                Box::into_raw(sender_ref) as PVOID,","                INFINITE,","                WT_EXECUTEINWAITTHREAD | WT_EXECUTEONLYONCE,","            )","        };","","        if success == 0 {","            Err(Error::last_os_error())","        } else {","            Ok(ChildExitWatcher { wait_handle: AtomicPtr::from(wait_handle), event_rx })","        }","    }","","    pub fn event_rx(&self) -> &Receiver<ChildEvent> {","        &self.event_rx","    }","}","","impl Drop for ChildExitWatcher {","    fn drop(&mut self) {","        unsafe {","            UnregisterWait(self.wait_handle.load(Ordering::Relaxed));","        }","    }","}","","#[cfg(test)]","mod test {","    use std::os::windows::io::AsRawHandle;","    use std::process::Command;","    use std::time::Duration;","","    use mio::{Events, Poll, PollOpt, Ready, Token};","","    use super::*;","","    #[test]","    pub fn event_is_emitted_when_child_exits() {","        const WAIT_TIMEOUT: Duration = Duration::from_millis(200);","","        let mut child = Command::new(\"cmd.exe\").spawn().unwrap();","        let child_exit_watcher = ChildExitWatcher::new(child.as_raw_handle()).unwrap();","","        let mut events = Events::with_capacity(1);","        let poll = Poll::new().unwrap();","        let child_events_token = Token::from(0usize);","","        poll.register(","            child_exit_watcher.event_rx(),","            child_events_token,","            Ready::readable(),","            PollOpt::oneshot(),","        )","        .unwrap();","","        child.kill().unwrap();","","        // Poll for the event or fail with timeout if nothing has been sent","        poll.poll(&mut events, Some(WAIT_TIMEOUT)).unwrap();","        assert_eq!(events.iter().next().unwrap().token(), child_events_token);","        // Verify that at least one `ChildEvent::Exited` was received","        assert_eq!(child_exit_watcher.event_rx().try_recv(), Ok(ChildEvent::Exited));","    }","}","mod tests {","        // Poll for the event or fail with timeout if nothing has been sent.","        // Verify that at least one `ChildEvent::Exited` was received.","use windows_sys::Win32::Foundation::{BOOLEAN, HANDLE};","use windows_sys::Win32::System::Threading::{","    RegisterWaitForSingleObject, UnregisterWait, WT_EXECUTEINWAITTHREAD, WT_EXECUTEONLYONCE,","};","use windows_sys::Win32::System::WindowsProgramming::INFINITE;","extern \"system\" fn child_exit_callback(ctx: *mut c_void, timed_out: BOOLEAN) {","        let mut wait_handle: HANDLE = 0;","                Box::into_raw(sender_ref).cast(),","            Ok(ChildExitWatcher {","                wait_handle: AtomicPtr::from(wait_handle as *mut c_void),","                event_rx,","            })","            UnregisterWait(self.wait_handle.load(Ordering::Relaxed) as HANDLE);","        let child_exit_watcher = ChildExitWatcher::new(child.as_raw_handle() as HANDLE).unwrap();","    RegisterWaitForSingleObject, UnregisterWait, INFINITE, WT_EXECUTEINWAITTHREAD,","    WT_EXECUTEONLYONCE,","use std::sync::{mpsc, Arc, Mutex};","use polling::os::iocp::{CompletionPacket, PollerIocpExt};","use polling::{Event, Poller};","struct Interest {","    poller: Arc<Poller>,","    event: Event,","}","","struct ChildExitSender {","    sender: mpsc::Sender<ChildEvent>,","    interest: Arc<Mutex<Option<Interest>>>,","}","","    let event_tx: Box<_> = unsafe { Box::from_raw(ctx as *mut ChildExitSender) };","    let _ = event_tx.sender.send(ChildEvent::Exited);","    let interest = event_tx.interest.lock().unwrap();","    if let Some(interest) = interest.as_ref() {","        interest.poller.post(CompletionPacket::new(interest.event)).ok();","    }","    event_rx: mpsc::Receiver<ChildEvent>,","    interest: Arc<Mutex<Option<Interest>>>,","        let (event_tx, event_rx) = mpsc::channel();","        let interest = Arc::new(Mutex::new(None));","        let sender_ref = Box::new(ChildExitSender { sender: event_tx, interest: interest.clone() });","                interest,","    pub fn event_rx(&self) -> &mpsc::Receiver<ChildEvent> {","","    pub fn register(&self, poller: &Arc<Poller>, event: Event) {","        *self.interest.lock().unwrap() = Some(Interest { poller: poller.clone(), event });","    }","","    pub fn deregister(&self) {","        *self.interest.lock().unwrap() = None;","    }","    use std::sync::Arc;","    use super::super::PTY_CHILD_EVENT_TOKEN;","        let poller = Arc::new(Poller::new().unwrap());","","        child_exit_watcher.register(&poller, Event::readable(PTY_CHILD_EVENT_TOKEN));","        let mut events = polling::Events::new();","        poller.wait(&mut events, Some(WAIT_TIMEOUT)).unwrap();","        assert_eq!(events.iter().next().unwrap().key, PTY_CHILD_EVENT_TOKEN);","use std::num::NonZeroU32;","    GetProcessId, RegisterWaitForSingleObject, UnregisterWait, INFINITE, WT_EXECUTEINWAITTHREAD,","    child_handle: HANDLE,","    pid: Option<NonZeroU32>,","            let pid = unsafe { NonZeroU32::new(GetProcessId(child_handle)) };","                child_handle,","                pid,","","    /// Retrieve the process handle of the underlying child process.","    ///","    /// This function does **not** pass ownership of the raw handle to you,","    /// and the handle is only guaranteed to be valid while the hosted application","    /// has not yet been destroyed.","    ///","    /// If you terminate the process using this handle, the terminal will get a","    /// timeout error, and the child watcher will emit an `Exited` event.","    pub fn raw_handle(&self) -> HANDLE {","        self.child_handle","    }","","    /// Retrieve the Process ID associated to the underlying child process.","    pub fn pid(&self) -> Option<NonZeroU32> {","        self.pid","    }","use windows_sys::Win32::Foundation::{BOOLEAN, FALSE, HANDLE};","    GetExitCodeProcess, GetProcessId, RegisterWaitForSingleObject, UnregisterWait, INFINITE,","    WT_EXECUTEINWAITTHREAD, WT_EXECUTEONLYONCE,","    child_handle: AtomicPtr<c_void>,","","    let mut exit_code = 0_u32;","    let child_handle = event_tx.child_handle.load(Ordering::Relaxed) as HANDLE;","    let status = unsafe { GetExitCodeProcess(child_handle, &mut exit_code) };","    let exit_code = if status == FALSE { None } else { Some(exit_code as i32) };","    event_tx.sender.send(ChildEvent::Exited(exit_code)).ok();","","        let sender_ref = Box::new(ChildExitSender {","            sender: event_tx,","            interest: interest.clone(),","            child_handle: AtomicPtr::from(child_handle as *mut c_void),","        });","        assert_eq!(child_exit_watcher.event_rx().try_recv(), Ok(ChildEvent::Exited(Some(1))));","use std::ptr;","    child_handle: AtomicPtr<c_void>,","        let mut wait_handle: HANDLE = ptr::null_mut();","            child_handle: AtomicPtr::from(child_handle),","                child_handle: AtomicPtr::from(child_handle),","                wait_handle: AtomicPtr::from(wait_handle),","        self.child_handle.load(Ordering::Relaxed) as HANDLE","use std::sync::{Arc, Mutex, mpsc};","    GetExitCodeProcess, GetProcessId, INFINITE, RegisterWaitForSingleObject, UnregisterWait,","use std::os::windows::process::ExitStatusExt;","use std::process::ExitStatus;","    let exit_status = if status == FALSE { None } else { Some(ExitStatus::from_raw(exit_code)) };","    event_tx.sender.send(ChildEvent::Exited(exit_status)).ok();","        let expected_status = ExitStatus::from_raw(1);","        assert_eq!(","            child_exit_watcher.event_rx().try_recv(),","            Ok(ChildEvent::Exited(Some(expected_status)))","        );"]}