et: SetName) -> &FontSetRef {","use foreign_types::ForeignTypeRef;","use super::ffi::{FcConfig, FcConfigDestroy, FcConfigGetCurrent, FcConfigGetFonts};","use super::{FontSetRef, SetName};","        unsafe { ConfigRef::from_ptr(FcConfigGetCurrent()) }","    pub type Config {","        type CType = FcConfig;","        fn drop = FcConfigDestroy;","    }","    type CType = FcConfig;","    fn drop = FcConfigDestroy;","    /// Wraps an FcConfig instance (owned)","    pub struct Config;","    /// Wraps an FcConfig reference (borrowed)","    pub struct ConfigRef;","    pub type Config {","        type CType = FcConfig;","        fn drop = FcConfigDestroy;","    }","    pub unsafe type Config {","use foreign_types::{foreign_type, ForeignTypeRef};","    /// Get the current configuration."]}