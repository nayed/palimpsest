{"format":"palimpsest-lines","version":1,"file":347,"commits":[1429],"opsStart":[0,2],"ops":[2,11],"texts":["use std::thread::{Builder, JoinHandle};","","/// Like `thread::spawn`, but with a `name` argument.","pub fn spawn_named<F, T, S>(name: S, f: F) -> JoinHandle<T>","where","    F: FnOnce() -> T + Send + 'static,","    T: Send + 'static,","    S: Into<String>,","{","    Builder::new().name(name.into()).spawn(f).expect(\"thread spawn works\")","}"]}