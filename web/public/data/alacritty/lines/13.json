l_generator::{Api, Fallbacks, GlobalGenerator, Profile, Registry};","","#[cfg(windows)]","use std::io;","#[cfg(windows)]","use std::fs::OpenOptions;","","#[cfg(windows)]","const WINPTY_PACKAGE_URL: &str = \"https://www.nuget.org/api/v2/package/winpty.NET/0.4.2\";","","    Registry::new(","        Api::Gl,","        (4, 5),","        Profile::Core,","        Fallbacks::All,","        [\"GL_ARB_blend_func_extended\"],","    ).write_bindings(GlobalGenerator, &mut file)","","    #[cfg(windows)]","    {","        embed_resource::compile(\"assets/windows/windows.rc\");","","        // Path is relative to target/{profile}/build/alacritty-HASH/out","        let file = Path::new(&env::var(\"OUT_DIR\").unwrap()).join(\"../../../winpty-agent.exe\");","        if !file.exists() {","            aquire_winpty_agent(&file);","        }","    }","}","","#[cfg(windows)]","fn aquire_winpty_agent(out_path: &Path) {","    let tmp_dir = TempDir::new(\"alacritty_build\").unwrap();","","    let mut response = reqwest::get(WINPTY_PACKAGE_URL).unwrap();","    let mut file = OpenOptions::new()","        .read(true)","        .write(true)","        .create(true)","        .open(tmp_dir.path().join(\"winpty_package.zip\")).unwrap();","","    io::copy(&mut response, &mut file).unwrap();","","    let mut archive = zip::ZipArchive::new(file).unwrap();","","    let target = match env::var(\"TARGET\").unwrap().split(\"-\").next().unwrap() {","        \"x86_64\" => \"x86\",","        \"i386\" => \"x64\",","        _ => panic!(\"architecture has no winpty binary\")","    };","","    let mut winpty_agent = archive.by_name(&format!(\"content/winpty/{}/winpty-agent.exe\", target)).unwrap();","","    io::copy(&mut winpty_agent, &mut File::create(out_path).unwrap()).unwrap();","const WINPTY_PACKAGE_URL: &str = \"https://github.com/rprichard/winpty/releases/download/0.4.3/winpty-0.4.3-msvc2015.zip\";","","        \"x86_64\" => \"x64\",","        \"i386\" => \"ia32\",","    let mut winpty_agent = archive.by_name(&format!(\"{}/bin/winpty-agent.exe\", target)).unwrap();","extern crate tempfile;","    let tmp_dir = tempfile::Builder::new().prefix(\"alacritty_build\").tempdir().unwrap();","use embed_resource;","use tempfile;","use reqwest;","use zip;","use tempfile;","#[cfg(windows)]","#[cfg(windows)]","use std::io;","const WINPTY_PACKAGE_URL: &str =","    \"https://github.com/rprichard/winpty/releases/download/0.4.3/winpty-0.4.3-msvc2015.zip\";","    Registry::new(Api::Gl, (4, 5), Profile::Core, Fallbacks::All, [\"GL_ARB_blend_func_extended\"])","        .write_bindings(GlobalGenerator, &mut file)","        .open(tmp_dir.path().join(\"winpty_package.zip\"))","        .unwrap();","        _ => panic!(\"architecture has no winpty binary\"),","        embed_resource::compile(\"extra/windows/windows.rc\");"]}