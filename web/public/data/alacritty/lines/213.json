ator, &mut file)","        .unwrap();","#[cfg(windows)]","use embed_resource;","","","    #[cfg(windows)]","    embed_resource::compile(\"../extra/windows/windows.rc\");","    if cfg!(not(any(feature = \"x11\", feature = \"wayland\", target_os = \"macos\", windows))) {","        panic!(\"at least one of the \\\"x11\\\"/\\\"wayland\\\" features must be enabled\");","    }","","#[cfg(not(any(feature = \"x11\", feature = \"wayland\", target_os = \"macos\", windows)))]","compile_error!(r#\"at least one of the \"x11\"/\"wayland\" features must be enabled\"#);","","use std::process::Command;","","use gl_generator::{Api, Fallbacks, GlobalGenerator, Profile, Registry};","    println!(\"cargo:rustc-env=GIT_HASH={}\", commit_hash());","","fn commit_hash() -> String {","    Command::new(\"git\")","        .args(&[\"rev-parse\", \"--short\", \"HEAD\"])","        .output()","        .ok()","        .and_then(|output| String::from_utf8(output.stdout).ok())","        .unwrap_or_default()","}","use std::collections::HashSet;","    Registry::new(Api::Gl, (3, 3), Profile::Core, Fallbacks::All, [\"GL_ARB_blend_func_extended\"])","    embed_resource::compile(\"./windows/windows.rc\");","    let mut version = String::from(env!(\"CARGO_PKG_VERSION\"));","    if let Some(commit_hash) = commit_hash() {","        version = format!(\"{} ({})\", version, commit_hash);","    }","    println!(\"cargo:rustc-env=VERSION={}\", version);","fn commit_hash() -> Option<String> {","        .map(|hash| hash.trim().into())","        .filter(|output| output.status.success())","    embed_resource::compile(\"./windows/alacritty.rc\");","    let mut file = File::create(Path::new(&dest).join(\"gl_bindings.rs\")).unwrap();","        .args([\"rev-parse\", \"--short\", \"HEAD\"])","        version = format!(\"{version} ({commit_hash})\");","    println!(\"cargo:rustc-env=VERSION={version}\");","    Registry::new(Api::Gl, (3, 3), Profile::Core, Fallbacks::All, [","        \"GL_ARB_blend_func_extended\",","        \"GL_KHR_debug\",","    ])","    .write_bindings(GlobalGenerator, &mut file)","    .unwrap();","    embed_resource::compile(\"./windows/alacritty.rc\", embed_resource::NONE);","        \"GL_KHR_robustness\",","    embed_resource::compile(\"./windows/alacritty.rc\", embed_resource::NONE)","        .manifest_required()","        .unwrap();"]}