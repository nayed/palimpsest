 API if the current platform allows it.","    pub prefer_egl: bool,","","            prefer_egl: Default::default(),","#[derive(ConfigDeserialize, Copy, Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]","    #[config(rename = \"glsl3\")]","    #[config(rename = \"gles2\")]","    #[config(rename = \"gles2_pure\")]","use serde::Serialize;","#[derive(ConfigDeserialize, Serialize, Copy, Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]","    #[serde(skip_serializing)]","#[derive(ConfigDeserialize, Serialize, Copy, Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]"]}