lf, value: f64) -> Result<Self::Value, E> {","                Ok(Size(FontSize::new(value as f32)))","            fn visit_u64<E: de::Error>(self, value: u64) -> Result<Self::Value, E> {","                Ok(Size(FontSize::new(value as f32)))","        deserializer.deserialize_any(NumVisitor)","#[derive(ConfigDeserialize, Debug, Clone, PartialEq, Eq)]","","    /// Whether to use the built-in font for box drawing characters.","    pub builtin_box_drawing: bool,","impl Default for Font {","    fn default() -> Font {","        Self {","            builtin_box_drawing: true,","            use_thin_strokes: Default::default(),","            glyph_offset: Default::default(),","            bold_italic: Default::default(),","            italic: Default::default(),","            offset: Default::default(),","            normal: Default::default(),","            bold: Default::default(),","            size: Default::default(),","        }","    }","}","","    #[config(removed = \"set the AppleFontSmoothing user default instead\")]","            use_thin_strokes: Default::default(),","use alacritty_config_derive::{ConfigDeserialize, SerdeReplace};","#[derive(SerdeReplace, Debug, Clone, PartialEq, Eq)]","                f.write_str(\"f64 or i64\")","            fn visit_i64<E: de::Error>(self, value: i64) -> Result<Self::Value, E> {","        Self(FontSize::new(11.25))","        impl Visitor<'_> for NumVisitor {","use serde::{Deserialize, Deserializer, Serialize, Serializer};","#[derive(ConfigDeserialize, Serialize, Debug, Clone, PartialEq, Eq)]","#[derive(ConfigDeserialize, Serialize, Debug, Clone, PartialEq, Eq)]","#[derive(ConfigDeserialize, Serialize, Debug, Default, Clone, PartialEq, Eq)]","","impl Serialize for Size {","    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>","    where","        S: Serializer,","    {","        serializer.serialize_f32(self.0.as_pt())","    }","}"]}