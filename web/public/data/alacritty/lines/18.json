es! debug_print {","    ($($t:tt)*) => {","        if cfg!(debug_assertions) {","            print!($($t)*);","        }","    }","}","","        if cfg!(feature = \"err-println\") {","            use std::io::Write;","            (writeln!(&mut ::std::io::stderr(), $($arg)*)).expect(\"stderr\");","        }","#[macro_export]","macro_rules! maybe {","    ($option:expr) => {","        match $option {","            Some(value) => value,","            None => return None,","        }","    }","}","            err_println!($($t)*);","            err_print!($($t)*);","#[macro_export]","macro_rules! err_print {","    ($($arg:tt)*) => {{","        if cfg!(feature = \"err-println\") {","            use std::io::Write;","            (write!(&mut ::std::io::stderr(), $($arg)*)).expect(\"stderr\");","        }","    }}","}","","        eprintln!($($arg)*);","","#[macro_export]","macro_rules! print {","    ($($arg:tt)*) => {{","        use std::io::Write;","        let _ = write!(::std::io::stdout(), $($arg)*);","    }};","}","","#[macro_export]","macro_rules! eprint {","    ($($arg:tt)*) => {{","        use std::io::Write;","        let _ = write!(::std::io::stderr(), $($arg)*);","    }};","}","        error!($($arg)*);"]}