","    fn default() -> Self {","        ScrollingHistory(10_000)","    }","}","","impl<'de> Deserialize<'de> for ScrollingHistory {","    fn deserialize<D>(deserializer: D) -> ::std::result::Result<Self, D::Error>","    where","        D: Deserializer<'de>,","    {","        let value = serde_yaml::Value::deserialize(deserializer)?;","        match u32::deserialize(value) {","            Ok(lines) => {","                if lines > MAX_SCROLLBACK_LINES {","                    error!(","                        \"Problem with config: scrollback size is {}, but expected a maximum of \\","                         {}; using {1} instead\",","                        lines, MAX_SCROLLBACK_LINES,","                    );","                    Ok(ScrollingHistory(MAX_SCROLLBACK_LINES))","                } else {","                    Ok(ScrollingHistory(lines))","                }","            },","            Err(err) => {","                error!(\"Problem with config: {}; using default value\", err);","                Ok(Default::default())","            },","        }","    }","}","use log::error;","use crate::config::{failure_default, LOG_TARGET_CONFIG, MAX_SCROLLBACK_LINES};","                        target: LOG_TARGET_CONFIG,","                        lines,","                        MAX_SCROLLBACK_LINES,","                error!(","                    target: LOG_TARGET_CONFIG,","                    \"Problem with config: {}; using default value\", err","                );","","    // TODO: DEPRECATED","    #[serde(deserialize_with = \"failure_default\")]","    faux_multiplier: Option<ScrollingMultiplier>,","    pub fn faux_multiplier(self) -> Option<u8> {","        self.faux_multiplier.map(|sm| sm.0)","","    // TODO: REMOVED","    pub auto_scroll: Option<bool>,","        Self(3)","        Self(10_000)","/// Struct for scrolling related settings.","    // Update the history size, used in ref tests.","use serde::de::Error as SerdeError;","use alacritty_config_derive::ConfigDeserialize;","","/// Maximum scrollback amount configurable.","const MAX_SCROLLBACK_LINES: u32 = 100_000;","#[derive(ConfigDeserialize, Copy, Clone, Debug, PartialEq, Eq)]","    pub multiplier: u8,","","}","impl Default for Scrolling {","    fn default() -> Self {","        Self { multiplier: 3, history: Default::default() }","    }","    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>","        let lines = u32::deserialize(deserializer)?;","","        if lines > MAX_SCROLLBACK_LINES {","            Err(SerdeError::custom(format!(","                \"exceeded maximum scrolling history ({}/{})\",","                lines, MAX_SCROLLBACK_LINES","            )))","        } else {","            Ok(Self(lines))","pub const MAX_SCROLLBACK_LINES: u32 = 100_000;","use alacritty_config_derive::{ConfigDeserialize, SerdeReplace};","#[derive(SerdeReplace, Copy, Clone, Debug, PartialEq, Eq)]","                \"exceeded maximum scrolling history ({lines}/{MAX_SCROLLBACK_LINES})\"","use serde::{Deserialize, Deserializer, Serialize};","#[derive(ConfigDeserialize, Serialize, Copy, Clone, Debug, PartialEq, Eq)]","#[derive(SerdeReplace, Serialize, Copy, Clone, Debug, PartialEq, Eq)]"]}