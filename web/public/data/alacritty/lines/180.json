{"format":"palimpsest-lines","version":1,"file":180,"commits":[819,820,918,983,1033,1410,1528],"opsStart":[0,2,12,24,28,46,50,52],"ops":[2,29,0,22,2,2,3,1,2,3,3,1,0,5,3,1,1,1,2,1,3,1,2,1,0,11,2,6,0,2,1,3,0,14,2,1,3,1,2,1,0,1,3,1,1,18,0,8,1,6,1,16],"texts":["#!/bin/bash","","# Check if any command failed","error=false","","# Run clippy on nightly builds","if [ \"$TRAVIS_RUST_VERSION\" == \"nightly\" ]; then","    cargo clippy --all-features --all-targets || error=true","fi","","# Run test in release mode if a tag is present, to produce an optimized binary","if [ -n \"$TRAVIS_TAG\" ]; then","    cargo test --release || error=true","else","    cargo test || error=true","fi","","# Test the font subcrate","cargo test -p font || error=true","","# Test the winpty subcrate","if [ \"$TRAVIS_OS_NAME\" == \"windows\" ]; then","    cp ./target/debug/winpty-agent.exe ./target/debug/deps && \\","        cargo test -p winpty || error=true","fi","","if [ $error == \"true\" ]; then","    exit 1","fi","    if [ -n \"$TRAVIS_TAG\" ]; then","        mkdir -p \"./target/debug/deps\"","        cp \"./target/release/winpty-agent.exe\" \"./target/debug/deps\"","    else","        cp \"./target/debug/winpty-agent.exe\" \"./target/debug/deps\"","    fi","    cargo test -p winpty || error=true","# Run clippy checks","if [ \"$CLIPPY\" == \"true\" ]; then","    cargo clippy --all-targets","    exit","# Run clippy rustfmt","if [ \"$RUSTFMT\" == \"true\" ]; then","    cargo fmt -- --check","    exit","fi","","    # Build separately so we generate an 'alacritty' binary without -HASH appended","    cargo build --release","    cargo test --release","    cargo test"]}