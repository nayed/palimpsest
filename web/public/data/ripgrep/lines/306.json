ity: Some(priority) }","}","    prioritized_alias(","        0,","        \"default\",","        \"RFC 8089 scheme (file://) (platform-aware)\",","        {","            #[cfg(not(windows))]","            {","                \"file://{host}{path}\"","            }","            #[cfg(windows)]","            {","                \"file://{path}\"","            }","        },","    ),","    alias(","        \"file\",","        \"RFC 8089 scheme (file://) with host\",","        \"file://{host}{path}\",","    ),","    alias(\"grep+\", \"grep+ scheme (grep+://)\", \"grep+://{path}:{line}\"),","    alias(","        \"kitty\",","        \"kitty-style RFC 8089 scheme (file://) with line number\",","        \"file://{host}{path}#{line}\",","    ),","        \"MacVim scheme (mvim://)\",","    prioritized_alias(1, \"none\", \"disable hyperlinks\", \"\"),","        \"TextMate scheme (txmt://)\",","    alias(","        \"vscode\",","        \"VS Code scheme (vscode://)\",","        \"vscode://file{path}:{line}:{column}\",","    ),","    alias(","        \"vscode-insiders\",","        \"VS Code Insiders scheme (vscode-insiders://)\",","        \"vscode-insiders://file{path}:{line}:{column}\",","    ),","    alias(","        \"vscodium\",","        \"VSCodium scheme (vscodium://)\",","        \"vscodium://file{path}:{line}:{column}\",","    ),","const fn alias(","    name: &'static str,","    description: &'static str,","    format: &'static str,",") -> HyperlinkAlias {","    HyperlinkAlias { name, description, format, display_priority: None }","    description: &'static str,","    HyperlinkAlias {","        name,","        description,","        format,","        display_priority: Some(priority),","    }","    alias(","        \"cursor\",","        \"Cursor scheme (cursor://)\",","        \"cursor://file{path}:{line}:{column}\",","    ),"]}