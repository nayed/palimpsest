{"format":"palimpsest-lines","version":1,"file":56,"commits":[141,150,1330],"opsStart":[0,2,18,18],"ops":[2,15,0,2,2,2,0,6,2,1,0,3,3,2,0,2,2,7],"texts":["#!/bin/sh","","if [ $# != 1 ]; then","  echo \"Usage: $(basename $0) version\" >&2","  exit 1","fi","version=\"$1\"","","for arch in i686 x86_64; do","  for target in apple-darwin unknown-linux-musl; do","    url=\"https://github.com/BurntSushi/ripgrep/releases/download/$version/ripgrep-$version-$arch-$target.tar.gz\"","    sha=$(curl -L -s \"$url\" | sha256sum)","    echo $version-$arch-$target $sha","  done","done","set -e","","# Linux and Darwin builds.","    sha=$(curl -sfSL \"$url\" | sha256sum)","    echo \"$version-$arch-$target $sha\"","","# Source.","for ext in zip tar.gz; do","  url=\"https://github.com/BurntSushi/ripgrep/archive/$version.$ext\"","  sha=$(curl -sfSL \"$url\" | sha256sum)","  echo \"source.$ext $sha\"","done"]}