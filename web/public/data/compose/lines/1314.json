  *projectOptions","    force   bool","    stop    bool","    volumes bool","}","","func removeCommand(p *projectOptions) *cobra.Command {","    opts := removeOptions{","        projectOptions: p,","    }","    cmd := &cobra.Command{","        Use:   \"rm [SERVICE...]\",","        Short: \"Removes stopped service containers\",","        Long: `Removes stopped service containers","","By default, anonymous volumes attached to containers will not be removed. You","can override this with -v. To list all volumes, use \"docker volume ls\".","","Any data which is not in a volume will be lost.`,","        RunE: func(cmd *cobra.Command, args []string) error {","            return runRemove(cmd.Context(), opts, args)","        },","    }","    f := cmd.Flags()","    f.BoolVarP(&opts.force, \"force\", \"f\", false, \"Don't ask to confirm removal\")","    f.BoolVarP(&opts.stop, \"stop\", \"s\", false, \"Stop the containers, if required, before removing\")","    f.BoolVarP(&opts.volumes, \"volumes\", \"v\", false, \"Remove any anonymous volumes attached to containers\")","    return cmd","}","","func runRemove(ctx context.Context, opts removeOptions, services []string) error {","    c, err := client.NewWithDefaultLocalBackend(ctx)","    if err != nil {","        return err","    }","","    project, err := opts.toProject(services)","    if err != nil {","        return err","    }","","    if opts.stop {","        _, err = progress.Run(ctx, func(ctx context.Context) (string, error) {","            err := c.ComposeService().Stop(ctx, project)","            return \"\", err","        })","        if err != nil {","            return err","        }","    }","","    reosurces, err := c.ComposeService().Remove(ctx, project, compose.RemoveOptions{","        DryRun: true,","    })","    if err != nil {","        return err","    }","","    if len(reosurces) == 0 {","        fmt.Println(\"No stopped containers\")","        return nil","    }","    msg := fmt.Sprintf(\"Going to remove %s\", strings.Join(reosurces, \", \"))","    if opts.force {","        fmt.Println(msg)","    } else {","        confirm, err := prompt.User{}.Confirm(msg, false)","        if err != nil {","            return err","        }","        if !confirm {","            return nil","        }","    }","","    _, err = progress.Run(ctx, func(ctx context.Context) (string, error) {","        _, err = c.ComposeService().Remove(ctx, project, compose.RemoveOptions{","            Volumes: opts.volumes,","            Force:   opts.force,","        })","        return \"\", err","    })","    return err","}","            err := c.ComposeService().Stop(ctx, project, compose.StopOptions{})","    c, err := client.New(ctx)","            err := c.ComposeService().Stop(ctx, project, compose.StopOptions{","                Services: services,","            })","        DryRun:   true,","        Services: services,","func removeCommand(p *projectOptions, backend compose.Service) *cobra.Command {","        RunE: Adapt(func(ctx context.Context, args []string) error {","            return runRemove(ctx, backend, opts, args)","        }),","func runRemove(ctx context.Context, backend compose.Service, opts removeOptions, services []string) error {","            err := backend.Stop(ctx, project, compose.StopOptions{","    reosurces, err := backend.Remove(ctx, project, compose.RemoveOptions{","        _, err = backend.Remove(ctx, project, compose.RemoveOptions{","    f.BoolP(\"all\", \"a\", false, \"Deprecated - no effect\")","    f.MarkHidden(\"all\") //nolint:errcheck","","        err = progress.Run(ctx, func(ctx context.Context) error {","            return backend.Stop(ctx, project, compose.StopOptions{","    resources, err := backend.Remove(ctx, project, compose.RemoveOptions{","    if len(resources) == 0 {","    msg := fmt.Sprintf(\"Going to remove %s\", strings.Join(resources, \", \"))","    return progress.Run(ctx, func(ctx context.Context) error {","        _, err := backend.Remove(ctx, project, compose.RemoveOptions{","        return err","        return backend.Stop(ctx, project, compose.StopOptions{","            Services: services,","    return backend.Remove(ctx, project, compose.RemoveOptions{","    \"github.com/docker/compose-cli/pkg/api\"","func removeCommand(p *projectOptions, backend api.Service) *cobra.Command {","func runRemove(ctx context.Context, backend api.Service, opts removeOptions, services []string) error {","        return backend.Stop(ctx, project, api.StopOptions{","    return backend.Remove(ctx, project, api.RemoveOptions{","        Force:    opts.force,","        Volumes:  opts.volumes,","        ValidArgsFunction: serviceCompletion(p),","        err := backend.Stop(ctx, project, api.StopOptions{","        if err != nil {","            return err","        }","    \"github.com/docker/compose/v2/pkg/api\"","        err := backend.Stop(ctx, project.Name, api.StopOptions{","    project, err := opts.toProjectName()","        err := backend.Stop(ctx, project, api.StopOptions{","        Use:   \"rm [OPTIONS] [SERVICE...]\",","    project, name, err := opts.projectOrName()","        err := backend.Stop(ctx, name, api.StopOptions{","            Project:  project,","    return backend.Remove(ctx, name, api.RemoveOptions{","        Project:  project,","        ValidArgsFunction: completeServiceNames(p),","    project, name, err := opts.projectOrName(services...)","    *ProjectOptions","func removeCommand(p *ProjectOptions, backend api.Service) *cobra.Command {","        ProjectOptions: p,","        Stop:     opts.stop,","    \"github.com/docker/cli/cli/command\"","func removeCommand(p *ProjectOptions, dockerCli command.Cli, backend api.Service) *cobra.Command {","            return runRemove(ctx, dockerCli, backend, opts, args)","        ValidArgsFunction: completeServiceNames(dockerCli, p),","func runRemove(ctx context.Context, dockerCli command.Cli, backend api.Service, opts removeOptions, services []string) error {","    project, name, err := opts.projectOrName(dockerCli, services...)","    project, name, err := opts.projectOrName(ctx, dockerCli, services...)","func removeCommand(p *ProjectOptions, dockerCli command.Cli, backend api.Compose) *cobra.Command {","func runRemove(ctx context.Context, dockerCli command.Cli, backend api.Compose, opts removeOptions, services []string) error {","    \"github.com/docker/compose/v2/pkg/compose\"","func removeCommand(p *ProjectOptions, dockerCli command.Cli, backendOptions *BackendOptions) *cobra.Command {","            return runRemove(ctx, dockerCli, backendOptions, opts, args)","func runRemove(ctx context.Context, dockerCli command.Cli, backendOptions *BackendOptions, opts removeOptions, services []string) error {","    backend, err := compose.NewComposeService(dockerCli, backendOptions.Options...)","    if err != nil {","        return err","    }","    \"errors\"","    \"fmt\"","    err = backend.Remove(ctx, name, api.RemoveOptions{","    if errors.Is(err, api.ErrNoResources) {","        _, _ = fmt.Fprintln(stdinfo(dockerCli), \"No stopped containers\")","        return nil","    }","    return err","    \"github.com/docker/compose/v5/pkg/api\"","    \"github.com/docker/compose/v5/pkg/compose\"","    \"github.com/spf13/cobra\"",""]}