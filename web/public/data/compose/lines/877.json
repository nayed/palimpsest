round()\"","        - pattern: 'context\\.TODO'","          pkg: '^context$'","          msg: \"in tests, use t.Context() instead of context.TODO()\"","    rules:","      - path-except: '_test\\.go'","        linters:","          - forbidigo","            - pkg: github.com/stretchr/testify/assert","              desc: Use \"gotest.tools/v3/assert\" instead","            - pkg: github.com/stretchr/testify/require","              desc: Use \"gotest.tools/v3/assert\" instead","            - pkg: github.com/stretchr/testify/suite","              desc: Do not use","    - gocognit","    gocognit:","      min-complexity: 30","  disable:","    # gocognit deliberately replaced gocyclo — do not re-enable. Cyclomatic","    # complexity charges a flat guard clause the same as a nested branch, so","    # our fail-fast style accumulated //nolint suppressions on functions that","    # are long but flat. Cognitive complexity penalizes nesting and barely","    # charges early returns, keeping the signal on genuinely tangled code.","    - gocyclo","    - gomodguard_v2","    gomodguard_v2:","        - module: github.com/pkg/errors","          recommendations:","            - errors","            - fmt","        - module: github.com/distribution/distribution","          reason: use distribution/reference","        - module: gotest.tools","          version: < 3.0.0","          reason: deprecated, pre-modules version","  build-tags:","    - e2e # Avoid \"unused\" linter issues for code only used in e2e.","    - perfsprint","        library-not-cli:","          # pkg/ is the SDK and internal/ its support code: neither may depend","          # on the CLI. A CLI-only component the library needs goes behind an","          # interface that cmd/ implements and injects (e.g. WithNavigationMenu).","          files:","            - \"**/pkg/**\"","            - \"**/internal/**\"","            - \"!**/pkg/e2e/**\"","          deny:","            - pkg: github.com/docker/compose/v5/cmd","        