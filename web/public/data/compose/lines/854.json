iption)","    assert.Equal(suite.T(), \"type\", m.Type)","}","","func (suite *StoreTestSuite) TestList() {","    err := suite.store.Create(\"test1\", TypeContext{}, nil)","    assert.Nil(suite.T(), err)","","    err = suite.store.Create(\"test2\", TypeContext{}, nil)","    assert.Nil(suite.T(), err)","","    contexts, err := suite.store.List()","    assert.Nil(suite.T(), err)","","    require.Equal(suite.T(), len(contexts), 2)","    assert.Equal(suite.T(), contexts[0].Name, \"test1\")","    assert.Equal(suite.T(), contexts[1].Name, \"test2\")","}","","func TestExampleTestSuite(t *testing.T) {","    suite.Run(t, new(StoreTestSuite))","}","    store, err := New(WithRoot(dir))","    err := suite.store.Create(\"test\", TypedContext{})","    require.Nil(suite.T(), err)","    meta, err := suite.store.Get(\"unknown\", nil)","    require.Nil(suite.T(), meta)","    require.Error(suite.T(), err)","    err := suite.store.Create(\"test\", TypedContext{","    })","    require.Nil(suite.T(), err)","    meta, err := suite.store.Get(\"test\", nil)","    require.Nil(suite.T(), err)","    require.NotNil(suite.T(), meta)","    require.Equal(suite.T(), \"test\", meta.Name)","    require.Equal(suite.T(), \"description\", meta.Metadata.Description)","    require.Equal(suite.T(), \"type\", meta.Metadata.Type)","    err := suite.store.Create(\"test1\", TypedContext{})","    require.Nil(suite.T(), err)","    err = suite.store.Create(\"test2\", TypedContext{})","    require.Nil(suite.T(), err)","    require.Nil(suite.T(), err)","    require.Equal(suite.T(), contexts[0].Name, \"test1\")","    require.Equal(suite.T(), contexts[1].Name, \"test2\")","    err := os.RemoveAll(suite.dir)","    require.Nil(suite.T(), err)","    \"github.com/docker/api/errdefs\"","","    err = suite.store.Create(\"test\", TypedContext{})","    require.EqualError(suite.T(), err, `context \"test\": already exists`)","    require.True(suite.T(), errdefs.IsAlreadyExistsError(err))","    require.EqualError(suite.T(), err,