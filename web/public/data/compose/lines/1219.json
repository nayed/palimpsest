Writer, *http.Request)) func(http.ResponseWriter, *http.Request) {","    return func(w http.ResponseWriter, r *http.Request) {","        fmt.Println(r.Method, r.URL.Path, r.RemoteAddr, r.UserAgent())","        handler(w, r)","    }","var healthy = true"]}