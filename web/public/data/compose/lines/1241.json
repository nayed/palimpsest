ables for services\")","    flags.StringVar(&opts.builder, \"builder\", \"\", \"Set builder to use\")","    flags.BoolVar(&opts.deps, \"with-dependencies\", false, \"Also build dependencies (transitively)\")","    // The build backends do not have a \"json\" progress; use \"plain\" instead","    uiMode := ui.Mode","    if uiMode == ui.ModeJSON {","        uiMode = ui.ModePlain","    }","        Progress: uiMode,","        uiMode = \"rawjson\"","        Pull:          opts.pull,","        Push:          opts.push,","        Progress:      uiMode,","        Args:          types.NewMappingWithEquals(opts.args),","        NoCache:       opts.noCache,","        Quiet:         opts.quiet,","        Services:      services,","        Deps:          opts.deps,","        SSHs:          SSHKeys,","        Builder:       builderName,","        Compatibility: opts.Compatibility,","        Pull:     opts.pull,","        Push:     opts.push,","        Progress: uiMode,","        Args:     types.NewMappingWithEquals(opts.args),","        NoCache:  opts.noCache,","        Quiet:    opts.quiet,","        Services: services,","        Deps:     opts.deps,","        SSHs:     SSHKeys,","        Builder:  builderName,","    print   bool","        Memory:   int64(opts.memory),","        Print:    opts.print,","    flags.BoolVar(&opts.print, \"print\", false, \"Print equivalent bake file\")","    \"github.com/docker/compose/v2/pkg/utils\"","    services = addBuildDependencies(services, project)","","","func addBuildDependencies(services []string, project *types.Project) []string {","    servicesWithDependencies := utils.NewSet(services...)","    for _, service := range services {","        build := project.Services[service].Build","        if build != nil {","            for _, target := range build.AdditionalContexts {","                if s, found := strings.CutPrefix(target, types.ServicePrefix); found {","                    servicesWithDependencies.Add(s)","                }","     