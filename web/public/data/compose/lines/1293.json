s(dockerCli, p),","    buildOpts := buildOptions{","        ProjectOptions: p,","    }","        RunE: p.WithServices(dockerCli, func(ctx context.Context, project *types.Project, services []string) error {","            return runCreate(ctx, dockerCli, backend, opts, buildOpts, project, services)","        }),","func runCreate(ctx context.Context, _ command.Cli, backend api.Service, createOpts createOptions, buildOpts buildOptions, project *types.Project, services []string) error {","    if err := createOpts.Apply(project); err != nil {","        return err","    }","","    var build *api.BuildOptions","    if !createOpts.noBuild {","        bo, err := buildOpts.toAPIBuildOptions(services)","        if err != nil {","            return err","        }","        build = &bo","    }","","    return backend.Create(ctx, project, api.CreateOptions{","        Build:                build,","        Services:             services,","        RemoveOrphans:        createOpts.removeOrphans,","        IgnoreOrphans:        createOpts.ignoreOrphans,","        Recreate:             createOpts.recreateStrategy(),","        RecreateDependencies: createOpts.dependenciesRecreateStrategy(),","        Inherit:              !createOpts.noInherit,","        Timeout:              createOpts.GetTimeout(),","        QuietPull:            false,","    })","}","","    flags.BoolVar(&opts.noBuild, \"no-build\", false, \"Don't build an image, even if it's policy.\")","    flags.StringVar(&opts.Pull, \"pull\", \"policy\", `Pull image before running (\"always\"|\"policy\"|\"never\")`)","    // e.g. if a service has pull_policy: build or its local image is policy","    \"slices\"","        if !opts.isPullPolicyValid() {","            return fmt.Errorf(\"invalid --pull option %q\", opts.Pull)","        }","","func (opts createOptions) isPullPolicyValid() bool {","    pullPolicies := []string{types.PullPolicyAlways, types.PullPolicyNever, types.PullPolicyBuild,","        types.PullPolicyMissing, types.PullPolicyIfNotPresent}","    return slices.Contains(pullPolicies, opts.Pull)","}","    flags.StringVar(&opts.Pull, \"pull\", \"policy\", `Pull image before running (\"always\"|\"missing\"|\"never\"|\"build\")`)","    \"github.com/compose-spec/compose-go/v2/types\"","    err := applyScaleOpts(project, opts.scale)","    if err != nil {","        return err","    }","    return nil","}","","func applyScaleOpts(project *types.Project, opts []string) error {","    for _, scale := range opts {","        err = setServiceScale(project, name, replicas)","        Short: \"Creates containers for a service\",","    flags.BoolVar(&opts.Build, \"build\", false, \"Build images before starting containers\")","    flags.BoolVar(&opts.noBuild, \"no-build\", false, \"Don't build an image, even if it's policy\")","    flags.BoolVar(&opts.forceRecreate, \"force-recreate\", false, \"Recreate containers even if their configuration and image haven't changed\")","    flags.BoolVar(&opts.removeOrphans, \"remove-orphans\", false, \"Remove containers for services not defined in the Compose file\")","    flags.BoolVar(&opts.quietPull, \"quiet-pull\", false, \"Pull without printing progress information\")","        QuietPull:            createOpts.quietPull,","    if opts.noInherit {","        return api.RecreateForce","    }","    AssumeYes     bool","    flags.BoolVarP(&opts.AssumeYes, \"y\", \"y\", false, `Assume \"yes\" as answer to all prompts and run non-interactively`)","        AssumeYes:            createOpts.AssumeYes,","    pullPolicies := []string{","        types.PullPolicyAlways, types.PullPolicyNever, types.PullPolicyBuild,","        types.PullPolicyMissing, types.PullPolicyIfNotPresent,","    }","    \"github.com/sirupsen/logrus\"","    \"github.com/spf13/pflag\"","    flags.BoolVarP(&opts.AssumeYes, \"yes\", \"y\", false, `Assume \"yes\" as answer to all prompts and run non-interactively`)","    flags.SetNormalizeFunc(func(f *pflag.FlagSet, name string) pflag.NormalizedName {","        // assumeYes was introduced by mistake as `--y`","        if name == \"y\" {","            logrus.Warn(\"--y is deprecated, please use --yes instead\")","            name = \"yes\"","        }","        return pflag.NormalizedName(name)","    })","func createCommand(p *ProjectOptions, dockerCli command.Cli, backend api.Compose) *cobra.Command {","func runCreate(ctx context.Context, _ command.Cli, backend api.Compose, createOpts createOptions, buildOpts buildOptions, project *types.Project, services []string) error {","    \"github.com/docker/compose/v2/pkg/compose\"","func createCommand(p *ProjectOptions, dockerCli command.Cli, backendOptions *BackendOptions) *cobra.Command {","            return runCreate(ctx, dockerCli, backendOptions, opts, buildOpts, project, services)","func runCreate(ctx context.Context, dockerCli command.Cli, backendOptions *BackendOptions, createOpts createOptions, buildOpts buildOptions, project *types.Project, services []string) error {","    backend, err := compose.NewComposeService(dockerCli, backendOptions.Options...)","    if err != nil {","        return err","    }","    if createOpts.AssumeYes {","        backendOptions.Options = append(backendOptions.Options, compose.WithPrompt(compose.AlwaysOkPrompt()))","    }","","    \"github.com/docker/compose/v5/pkg/compose\"","    \"github.com/docker/compose/v5/pkg/api\"","    \"github.com/docker/compose/v5/pkg/compose\"","        name, val, ok := strings.Cut(scale, \"=\")","        if !ok || val == \"\" {","        replicas, err := strconv.Atoi(val)","        if !slices.Contains(validPullPolicies, opts.Pull) {","var validPullPolicies = []string{","    types.PullPolicyAlways, types.PullPolicyNever, types.PullPolicyBuild,","    types.PullPolicyMissing, types.PullPolicyIfNotPresent,","    \"errors\"","                return errors.New(\"--build and --no-build are incompatible\")","                return errors.New(\"--force-recreate and --no-recreate are incompatible\")","    // same contract as up: an active scheduled job is refused before any","    // resource is created — silently not scheduling would break expectations","    if err := rejectScheduledJobs(project); err != nil {","        return err","    }","    \"github.com/docker/compose/v5/cmd/display\"","        RunE: func(cmd *cobra.Command, args []string) error {","            err := p.WithServices(dockerCli, func(ctx context.Context, project *types.Project, services []string) error {","                return runCreate(ctx, dockerCli, backendOptions, opts, buildOpts, project, services)","            })(cmd, args)","            if jobErr, replaced := jobTargetErr(cmd.Context(), dockerCli, p, args, err); replaced {","                if display.Mode == display.ModeJSON {","                    return makeJSONError(jobErr)","                }","                return jobErr","            }","            return err","        },","    flags.SetNormalizeFunc(normalizeYesFlag)","// normalizeYesFlag maps the --y spelling of --yes, introduced by mistake, to --yes.","func normalizeYesFlag(_ *pflag.FlagSet, name string) pflag.NormalizedName {","    if name == \"y\" {","        logrus.Warn(\"--y is deprecated, please use --yes instead\")","        name = \"yes\"","    }","    return pflag.NormalizedName(name)","}","","        if !ok || name == \"\" || val == \"\" {","    \"github.com/docker/compose/v5/pkg/utils\"","            opts.removeOrphans = removeOrphansFromEnv(cmd.Flags(), opts.removeOrphans)","    createOpts.ignoreOrphans = utils.StringToBool(project.Environment[ComposeIgnoreOrphans])","    if createOpts.ignoreOrphans && createOpts.removeOrphans {","        return fmt.Errorf(\"cannot combine %s and --remove-orphans\", ComposeIgnoreOrphans)","    }","    ignoreOrphans, err := resolveIgnoreOrphans(project, createOpts.removeOrphans)","    if err != nil {","        return err","    createOpts.ignoreOrphans = ignoreOrphans","        RunE: p.WithServices(dockerCli, func(ctx context.Context, project *types.Project, services []string) error {","            return runCreate(ctx, dockerCli, backendOptions, opts, buildOpts, project, services)","        }),"]}