ate {","        return compose.RecreateNever","    }","    if opts.recreateDeps {","        return compose.RecreateForce","    }","    return compose.RecreateDiverged","}","","func (opts createOptions) GetTimeout() *time.Duration {","    if opts.timeChanged {","        t := time.Duration(opts.timeout) * time.Second","        return &t","    }","    return nil","}","","func (opts createOptions) Apply(project *types.Project) {","    if opts.Build {","        for i, service := range project.Services {","            service.PullPolicy = types.PullPolicyBuild","            project.Services[i] = service","        }","    }","    if opts.noBuild {","        for i, service := range project.Services {","            service.Build = nil","            project.Services[i] = service","        }","    }","}","            if service.Build == nil {","                continue","            }","    \"github.com/docker/compose-cli/pkg/api\"","func createCommand(p *projectOptions, backend api.Service) *cobra.Command {","            return backend.Create(ctx, project, api.CreateOptions{","        return api.RecreateNever","        return api.RecreateForce","    return api.RecreateDiverged","        return api.RecreateNever","        return api.RecreateForce","    return api.RecreateDiverged","        ValidArgsFunction: serviceCompletion(p),","    \"github.com/docker/compose/v2/pkg/api\"","    ignoreOrphans bool","                IgnoreOrphans:        opts.ignoreOrphans,","    Pull          string","            opts.Apply(project)","    flags.StringVar(&opts.Pull, \"pull\", \"missing\", `Pull image before running (\"always\"|\"missing\"|\"never\")`)","    if opts.Pull != \"\" {","        for i, service := range project.Services {","            service.PullPolicy = opts.Pull","            project.Services[i] = service","        }","    }","            if service.Image == \"\" {","                service.Image = api.GetImageNameOrDefault(service, project.Name)","            }","        Use: