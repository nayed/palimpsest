"    for filter := range filters {","        if _, ok := acceptedListFilters[filter]; !ok {","            return errors.New(\"invalid filter '\" + filter + \"'\")","        }","    if len(filters) > 0 {","            if match(filters, \"name\", s.Name) {","                filtered = append(filtered, s)","    view := make([]stackView, len(stackList))","    for i, s := range stackList {","        view[i] = stackView{","            Name:        s.Name,","            Status:      strings.TrimSpace(s.Status + \" \" + s.Reason),","            ConfigFiles: s.ConfigFiles,","        }","    }"]}