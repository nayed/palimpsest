and","   limitations under the License.","*/","","package compose","","import (","    \"context\"","    \"fmt\"","    \"io\"","    \"os\"","","    \"github.com/spf13/cobra\"","","    \"github.com/docker/compose-cli/client\"",")","","func listCommand() *cobra.Command {","    opts := composeOptions{}","    lsCmd := &cobra.Command{","        Use: \"ls\",","        RunE: func(cmd *cobra.Command, args []string) error {","            return runList(cmd.Context(), opts)","        },","    }","    lsCmd.Flags().StringVarP(&opts.Name, \"project-name\", \"p\", \"\", \"Project name\")","    return lsCmd","}","","func runList(ctx context.Context, opts composeOptions) error {","    c, err := client.New(ctx)","    if err != nil {","        return err","    }","    stackList, err := c.ComposeService().List(ctx, opts.Name)","    if err != nil {","        return err","    }","","    err = printSection(os.Stdout, func(w io.Writer) {","        for _, stack := range stackList {","            fmt.Fprintf(w, \"%s\\t%s\\n\", stack.Name, stack.Status)","        }","    }, \"NAME\", \"STATUS\")","    return err","}","    \"github.com/docker/compose-cli/api/client\"","   Copyright 2020 Docker Compose CLI authors","    \"github.com/spf13/pflag\"","    \"github.com/docker/compose-cli/api/compose\"","    \"github.com/docker/compose-cli/formatter\"","    addComposeCommonFlags(lsCmd.Flags(), &opts)","func addComposeCommonFlags(f *pflag.FlagSet, opts *composeOptions) {","    f.StringVarP(&opts.Name, \"project-name\", \"p\", \"\", \"Project name\")","    f.StringVar(&opts.Format, \"format\", \"\", \"Format the output. Values: [pretty | json]. (Default: pretty)\")","}","","    view := viewFromStackList(stackList)","    return formatter.Print(view, opts.Format, os.Stdout, func(w io.Writer) {","        for _, stack := range view {","            _, _ = fmt.Fprintf(w, \"%s\\t%s\\n\", stack.Name, stack.Status)","}","","type stackView struct {","    Name   string","    Status string","}","","func viewFromStackList(stackList []compose.Stack) []stackView {","    retList := make([]stackView, len(stackList))","    for i, s := range stackList {","        retList[i] = stackView{","            Name:   s.Name,","            Status: s.Status,","        }","    }","    return retList","    \"strings\"","            Status: strings.TrimSpace(fmt.Sprintf(\"%s %s\", s.Status, s.Reason)),","    if opts.Quiet {","        for _, s := range stackList {","            fmt.Println(s.Name)","        }","        return nil","    }","    c, err := client.NewWithDefaultLocalBackend(ctx)","        Use:   \"ls\",","        Short: \"List running compose projects\",","    stackList, err := c.ComposeService().List(ctx, opts.ProjectName)","    \"github.com/docker/compose-cli/cli/formatter\"","type lsOptions struct {","    Format string","    Quiet  bool","}","","    opts := lsOptions{}","    lsCmd.Flags().StringVar(&opts.Format, \"format\", \"pretty\", \"Format the output. Values: [pretty | json].\")","    lsCmd.Flags().BoolVarP(&opts.Quiet, \"quiet\", \"q\", false, \"Only display IDs\")","func runList(ctx context.Context, opts lsOptions) error {","    stackList, err := c.ComposeService().List(ctx, \"\")","    \"github.com/docker/cli/opts\"","    Filter opts.FilterOpt","    opts := lsOptions{Filter: opts.NewFilterOpt()}","    lsCmd.Flags().BoolVarP(&opts.Quiet, \"quiet\", \"q\", false, \"Only display IDs.\")","    lsCmd.Flags().Var(&opts.Filter, \"filter\", \"Filter output based on conditions provided.\")","","var acceptedListFilters = map[string]bool{","    \"name\": true,","}","","    filters := opts.Filter.Value()","    err := filters.Validate(acceptedListFilters)","    if err != nil {","        return err","    }","","    stackList, err := c.ComposeService().List(ctx)","","    if filters.Len() > 0 {","        var filtered []compose.Stack","        for _, s := range stackList {","            if filters.Contains(\"name\") && !filters.Match(\"name\", s.Name) {","                continue","            }","            filtered = append(filtered, s)","        }","        stackList = filtered","    }","","    \"github.com/docker/compose-cli/api/context/store\"","    All    bool","func listCommand(contextType string) *cobra.Command {","    if contextType == store.DefaultContextType {","        lsCmd.Flags().BoolVarP(&opts.All, \"all\", \"a\", false, \"Show all stopped Compose projects\")","    }","    stackList, err := c.ComposeService().List(ctx, compose.ListOptions{All: opts.All})","    c, err := client.New(ctx)","func listCommand(contextType string, backend compose.Service) *cobra.Command {","        RunE: Adapt(func(ctx context.Context, args []string) error {","            return runList(ctx, backend, opts)","        }),","func runList(ctx context.Context, backend compose.Service, opts lsOptions) error {","    stackList, err := backend.List(ctx, compose.ListOptions{All: opts.All})","    \"github.com/docker/compose-cli/pkg/api\"","func listCommand(contextType string, backend api.Service) *cobra.Command {","func runList(ctx context.Context, backend api.Service, opts lsOptions) error {","    stackList, err := backend.List(ctx, api.ListOptions{All: opts.All})","        var filtered []api.Stack","func viewFromStackList(stackList []api.Stack) []stackView {","        ValidArgsFunction: noCompletion(),","    \"github.com/docker/compose-cli/cmd/formatter\"","","func listCommand(backend api.Service) *cobra.Command {","    lsCmd.Flags().BoolVarP(&opts.All, \"all\", \"a\", false, \"Show all stopped Compose projects\")","    \"github.com/docker/compose/v2/cmd/formatter\"","    \"github.com/docker/compose/v2/pkg/api\"","            _, _ = fmt.Fprintf(w, \"%s\\t%s\\t%s\\n\", stack.Name, stack.Status, stack.ConfigFiles)","    }, \"NAME\", \"STATUS\", \"CONFIG FILES\")","    Name        string","    Status      string","    ConfigFiles string","            Name:        s.Name,","            Status:      strings.TrimSpace(fmt.Sprintf(\"%s %s\", s.Status, s.Reason)),","     