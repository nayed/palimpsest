g\")","}","","func (s *composeService) export(ctx context.Context, projectName string, options api.ExportOptions) error {","    projectName = strings.ToLower(projectName)","","    container, err := s.getSpecifiedContainer(ctx, projectName, oneOffInclude, false, options.Service, options.Index)","    if err != nil {","        return err","    }","","    if options.Output == \"\" && s.dockerCli.Out().IsTerminal() {","        return errors.New(\"output option is required when exporting to terminal\")","    }","","    if err := command.ValidateOutputPath(options.Output); err != nil {","        return errors.Wrap(err, \"failed to export container\")","    }","","    clnt := s.dockerCli.Client()","","    w := progress.ContextWriter(ctx)","","    name := getCanonicalContainerName(container)","    msg := fmt.Sprintf(\"export %s to %s\", name, options.Output)","","    w.Event(progress.Event{","        ID:         name,","        Text:       msg,","        Status:     progress.Working,","        StatusText: \"Exporting\",","    })","","    responseBody, err := clnt.ContainerExport(ctx, container.ID)","    if err != nil {","        return err","    }","","    defer responseBody.Close()","","    if !s.dryRun {","        if options.Output == \"\" {","            _, err := io.Copy(s.dockerCli.Out(), responseBody)","            return err","        }","    ","        if err = command.CopyToFile(options.Output, responseBody); err != nil {","            return err","        }","    }","","    w.Event(progress.Event{","        ID:         name,","        Text:       msg,","        Status:     progress.Done,","        StatusText: \"Exported\",","    })","","    return nil","}","    defer func() {","        if err := responseBody.Close(); err != nil {","            w.Event(progress.Event{","                ID:         name,","                Text:       msg,","                Status:     progress.Error,","                StatusText: fmt.Sprintf(\"Failed to close response body: %v\", err),","            })","        }","    }()","","        if err := command.CopyToFile(options.Output, responseBody); err != nil {","        return fmt.Errorf(\"output option is required when exporting to terminal\")","        return fmt.Errorf(\"failed to export container: %w\", err)","    \"github.com/moby/sys/atomicwriter\"","    if options.Output == \"\" {","        if s.dockerCli.Out().IsTerminal() {","            return fmt.Errorf(\"output option is required when exporting to terminal\")","        }","    } else if err := command.ValidateOutputPath(options.Output); err != nil {","        } else {","            writer, err := atomicwriter.New(options.Output, 0o600)","            if err != nil {","                return err","            }","            defer func() { _ = writer.Close() }()","            _, err = io.Copy(writer, responseBody)","    clnt := s.apiClient()","        if s.stdout().IsTerminal() {","    responseBody, err := s.apiClient().ContainerExport(ctx, container.ID)","            _, err := io.Copy(s.stdout(), responseBody)","    s.events(ctx, progress.Event{","            s.events(ctx, progress.Event{","    s.events(ctx, progress.Event{","    return progress.Run(ctx, func(ctx context.Context) error {","    }, s.stdinfo(), \"export\")","    }, \"export\", s.events)","    s.events.On(progress.Event{","            s.events.On(progress.Event{","    s.events.On(progress.Event{","        ID:     name,","        Text:   progress.StatusExporting,","        Status: progress.Working,","            s.events.On(progress.ErrorEventf(name, \"Failed to close response body: %s\", err.Error()))","        ID:     name,","        Text:   progress.StatusExported,","        Status: progress.Done,","    return Run(ctx, func(ctx context.Context) error {","    s.events.On(api.Resource{","        Text:   api.StatusExporting,","        Status: api.Working,","            s.events.On(errorEventf(name, \"Failed to close response body: %s\", err.Error()))","    s.events.On(api.Resource{","        Text:   api.StatusExported,","        Status: api.Done,","    \"github.com/docker/compose/v5/pkg/api\"","","    \"github.com/docker/compose/v5/pkg/api\"","    \"github.com/moby/moby/client\"","    responseBody, err := s.apiClient().ContainerExport(ctx, container.ID, client.ContainerExportOptions{})","    \"errors\"","            return errors.New(\"output option is required when exporting to terminal\")","package containerops","    \"github.com/docker/compose/v5/internal/inspect\"","    \"github.com/docker/compose/v5/internal/naming\"","    \"github.com/docker/compose/v5/internal/progress\"","// Export writes the filesystem of a container of a service as a tar archive.","func (s *Service) Export(ctx context.Context, projectName string, options api.ExportOptions) error {","    container, err := s.backend.SpecifiedContainer(ctx, projectName, inspect.OneOffInclude, false, options.Service, options.Index)","        if s.backend.CLI().Out().IsTerminal() {","    name := naming.CanonicalContainerName(container)","    s.backend.Events().On(api.Resource{","    responseBody, err := s.backend.APIClient().ContainerExport(ctx, container.ID, client.ContainerExportOptions{})","            s.backend.Events().On(progress.Error(name, \"Failed to close response body: \"+err.Error()))","    if !s.backend.DryRun() {","            _, err := io.Copy(s.backend.CLI().Out(), responseBody)","    s.backend.Events().On(api.Resource{","    \"github.com/docker/compose/v5/internal/engine\"","    container, err := s.backend.SpecifiedContainer(ctx, projectName, engine.OneOffInclude, false, options.Service, options.Index)"]}