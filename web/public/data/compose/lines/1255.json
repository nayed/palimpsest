              if !options.IgnoreFailures {","                        return err","                    }","                    w.TailMsgf(\"Pushing %s: %s\", service.Name, err.Error())","                return nil","            })","        }","func (s *composeService) pushServiceImage(ctx context.Context, tag string, info moby.Info, configFile driver.Auth, w progress.Writer, quietPush bool) error {","    ref, err := reference.ParseNormalizedNamed(tag)","    stream, err := s.apiClient().ImagePush(ctx, tag, moby.ImagePushOptions{","            toPushProgressEvent(tag, jm, w)","","    if isDone(jm) {","","func isDone(msg jsonmessage.JSONMessage) bool {","    // TODO there should be a better way to detect push is done than such a status message check","    switch strings.ToLower(msg.Status) {","    case \"pushed\", \"layer already exists\":","        return true","    default:","        return false","    }","}","    \"github.com/docker/docker/api/types/system\"","func (s *composeService) pushServiceImage(ctx context.Context, tag string, info system.Info, configFile driver.Auth, w progress.Writer, quietPush bool) error {","    \"github.com/compose-spec/compose-go/v2/types\"","    \"github.com/docker/docker/api/types/image\"","    stream, err := s.apiClient().ImagePush(ctx, tag, image.PushOptions{","            if options.ImageMandatory && service.Image == \"\" {","                return fmt.Errorf(\"%q attribut is mandatory to push an image for service %q\", \"service.image\", service.Name)","            }","                return fmt.Errorf(\"%q attribute is mandatory to push an image for service %q\", \"service.image\", service.Name)","            if options.ImageMandatory && service.Image == \"\" && service.Provider == nil {","    \"github.com/docker/compose/v2/internal/registry\"","                err := s.pushServiceImage(ctx, tag, s.configFile(), w, options.Quiet)","func (s *composeService) pushServiceImage(ctx context.Context, tag string, configFile driver.Auth, w progress.Writer, quietPush bool) error {","    authConfig, err := configFile.GetAuthConfig(registry.GetAuthConfigKey(ref))","    authConfig, err := configFile.GetAuthConfig(registry.GetAuthConfigKey(reference.Domain(ref)))","                err := s.pushServiceImage(ctx, tag, w, options.Quiet)","func (s *composeService) pushServiceImage(ctx context.Context, tag string, w progress.Writer, quietPush bool) error {","    authConfig, err := s.configFile().GetAuthConfig(registry.GetAuthConfigKey(reference.Domain(ref)))","            s.events(ctx, progress.Event{","                s.events(ctx, progress.NewEvent(tag, progress.Working, \"Pushing\"))","                err := s.pushServiceImage(ctx, tag, options.Quiet)","                        s.events(ctx, progress.NewEvent(tag, progress.Error, err.Error()))","                    s.events(ctx, progress.NewEvent(tag, progress.Warning, err.Error()))","                } else {","                    s.events(ctx, progress.NewEvent(tag, progress.Done, \"Pushed\"))","func (s *composeService) pushServiceImage(ctx context.Context, tag string, quietPush bool) error {","            toPushProgressEvent(ctx, tag, jm, s.events)","func toPushProgressEvent(ctx context.Context, prefix string, jm jsonmessage.JSONMessage, events EventBus) {","    events(ctx, progress.Event{","        ParentID:   prefix,","        ID:         jm.ID,","    return progress.Run(ctx, func(ctx context.Context) error {","    }, s.stdinfo(), \"push\")","    }, \"push\", s.events)","            s.events.On(progress.Event{","                s.events.On(progress.NewEvent(tag, progress.Working, \"Pushing\"))","                        s.events.On(progress.NewEvent(tag, progress.Error, err.Error()))","                    s.events.On(progress.NewEvent(tag, progress.Warning, err.Error()))","                    s.events.On(progress.NewEvent(tag, progress.Done, \"Pushed\"))","            toPushProgressEvent(tag, jm, s.events)","func toPushProgressEvent(prefix string, jm jsonmessage.JSONMessage, events progress.EventProcessor) {","    events.On(progress.Event{","        ParentID: prefix,","        ID:       jm.ID,","        Text:     text,","        Status:   status,","        Current:  current,","        Total:    total,","        Percent:  percent,","    return Run(ctx, func(ctx context.Context) error {","            s.events.On(api.Resource{","                Status: api.Done,","                s.events.On(newEvent(tag, api.Working, \"Pushing\"))","                        s.events.On(newEvent(tag, api.Error, err.Error()))","                    s.events.On(newEvent(tag, api.Warning, err.Error()))","                    s.events.On(newEvent(tag, api.Done, \"Pushed\"))","func toPushProgressEvent(prefix string, jm jsonmessage.JSONMessage, events api.EventProcessor) {","        status  = api.Working","        status = api.Done","        status = api.Error","    events.On(api.Resource{","    \"github.com/docker/compose/v5/internal/registry\"","    \"github.com/docker/compose/v5/pkg/api\"","                if percent > 100 {","                    percent = 100","                }","    \"github.com/moby/moby/api/types/jsonstream\"","    \"github.com/moby/moby/client\"","    stream, err := s.apiClient().ImagePush(ctx, tag, client.ImagePushOptions{","        var jm jsonstream.Message","func toPushProgressEvent(prefix string, jm jsonstream.Message, events api.EventProcessor) {","        // FIXME(thaJeztah): what's the replacement for Progress.String()?","        // text = jm.Progress.String()","func isDone(msg jsonstream.Message) bool {","    \"github.com/docker/go-units\"","        text = progressText(jm.Progress)","","// progressText is a minimal variant of [jsonmessage.JSONProgress.String()]","//","// [jsonmessage.JSONProgress.String()]: https://github.com/moby/moby/blob/v28.5.2/pkg/jsonmessage/jsonmessage.go#L54-L117","func progressText(p *jsonstream.Progress) string {","    switch {","    case p.Current <= 0 && p.Total <= 0:","        return \"\"","    case p.Units == \"\": // no units, use bytes","        current := units.HumanSize(float64(p.Current))","        if p.Total <= 0 || p.Total > p.Current {","            // remove total display if the reported current is wonky.","            return fmt.Sprintf(\"%8v\", current)","        }","        total := units.HumanSize(float64(p.Total))","        return fmt.Sprintf(\"%8v/%v\", current, total)","    default:","        if p.Total <= 0 || p.Total > p.Current {","            // remove total display if the reported current is wonky.","            return fmt.Sprintf(\"%d %s\", p.Current, p.Units)","        }","        return fmt.Sprintf(\"%d/%d %s\", p.Current, p.Total, p.Units)","    }","}","                percent = min(int(jm.Progress.Current*100/jm.Progress.Total), 100)","    encodedAuth, err := registry.EncodedAuth(ref, s.configFile())","        RegistryAuth: encodedAuth,","    eg, ctx := newLimitedErrgroup(ctx, s.maxConcurrency)","    encodedAuth, err := registry.EncodedAuth(ref, s.authProvider())","    \"github.com/containerd/errdefs\"","                if options.IgnoreMissing && s.isMissingLocally(ctx, tag) {","                    s.events.On(newEvent(tag, api.Done, \"Skipped\", \"No local image\"))","                    return nil","                }","// isMissingLocally tells whether the image is known to be absent from the local image store; any other failure","// to look it up is left to the push to report.","func (s *composeService) isMissingLocally(ctx context.Context, tag string) bool {","    _, err := s.apiClient().ImageInspect(ctx, tag)","    return errdefs.IsNotFound(err)","}","","    \"github.com/docker/compose/v5/internal/concurrency\"","    eg, ctx := concurrency.NewErrgroup(ctx, s.maxConcurrency)","    \"github.com/docker/compose/v5/internal/progress\"","                    s.events.On(progress.New(tag, api.Done, \"Skipped\", \"No local image\"))","                s.events.On(progress.New(tag, api.Working, \"Pushing\"))","                        s.events.On(progress.New(tag, api.Error, err.Error()))","                    s.events.On(progress.New(tag, api.Warning, err.Error()))","                    s.events.On(progress.New(tag, api.Done, \"Pushed\"))","    return decodeProgressStream(stream, func(jm jsonstream.Message) {","    })","                percent = progressPercent(jm.Progress.Current, jm.Progress.Total)"]}