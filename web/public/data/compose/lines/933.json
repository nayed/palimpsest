ns and","   limitations under the License.","*/","","    \"gotest.tools/v3/assert\"","    \"gotest.tools/v3/assert/cmp\"","    assert.Assert(t, cmp.Len(err.WrappedErrors(), 1))","    assert.Assert(t, cmp.Len(result.WrappedErrors(), 1))","    assert.Assert(t, cmp.Len(err.WrappedErrors(), 2))","    assert.Error(t, err, \"Error: first\\nError: second\")","    assert.NilError(t, errors.Unwrap(err))","    assert.Error(t, e, \"first\")","    assert.NilError(t, err.ErrorOrNil())","    assert.Error(t, e, \"error\")","    assert.Error(t, e, \"Error: error\")"]}