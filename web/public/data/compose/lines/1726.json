-1-extraLines(info)-extraLines(errMessage), 0)","        clearLine()","        moveCursorUp(lines)","        carriageReturn()","        saveCursor()","        moveCursor(height-extraLines(menu), 0)","        clearLine()","        carriageReturn()","        restoreCursor()","    carriageReturn()","    saveCursor()","    // clearLine()","        moveCursorDown(1)","        clearLine()","    restoreCursor()","        showCursor()","        newLine()","        clearLine()","        newLine()","        carriageReturn()","    case keyboard.KeyCtrlZ:","        _ = syscall.Kill(0, syscall.SIGSTOP)","        handleCtrlZ()","    \"strings\"","    Detach                func()","    var items []string","        items = append(items, shortcutKeyColor(\"v\")+navColor(\" View in Docker Desktop\"))","        items = append(items, shortcutKeyColor(\"o\")+navColor(\" View Config\"))","    items = append(items, shortcutKeyColor(\"w\")+navColor(isEnabled+\" Watch\"))","    items = append(items, shortcutKeyColor(\"d\")+navColor(\" Detach\"))","","    return strings.Join(items, \"   \")","    case 'd':","        lk.clearNavigationMenu()","        lk.Detach()","func (lk *LogKeyboard) EnableDetach(detach func()) {","    lk.Detach = detach","}","","    \"github.com/docker/compose/v5/internal/tracing\"","    \"github.com/docker/compose/v5/pkg/api\"","","    \"github.com/docker/compose/v5/internal/tracing\"","    \"github.com/docker/compose/v5/pkg/api\"","    for range height {","    for range lines {","    IsLogsViewEnabled     bool","func NewKeyboardManager(isDockerDesktopActive, isLogsViewEnabled bool, sc chan<- os.Signal) *LogKeyboard {","        IsLogsViewEnabled:     isLogsViewEnabled,","    if lk.IsLogsViewEnabled {","        items = append(items, shortcutKeyColor(\"l\")+navColor(\" View Logs\"))","    }","","func (lk *LogKeyboard) openDDLogsView(ctx context.Context) {","    if !lk.IsLogsViewEnabled {","        return","    }","    go func() {","        _ = tracing.EventWrapFuncForErrG