    }","    return &composev1.ComposeDownResponse{ProjectName: projectName}, Client(ctx).ComposeService().Down(ctx, projectName)","}","","func (p *proxy) Services(ctx context.Context, request *composev1.ComposePsRequest) (*composev1.ComposePsResponse, error) {","    projectName := request.GetProjectName()","    if projectName == \"\" {","        project, err := getComposeProject(request.Files, request.WorkDir, request.ProjectName)","        if err != nil {","            return nil, err","        }","        projectName = project.Name","    }","    services, err := Client(ctx).ComposeService().Ps(ctx, projectName)","    if err != nil {","        return nil, err","    }","    response := []*composev1.Service{}","    for _, service := range services {","        response = append(response, &composev1.Service{","            Id:       service.ID,","            Name:     service.Name,","            Replicas: uint32(service.Replicas),","            Desired:  uint32(service.Desired),","            Ports:    service.Ports,","        })","    }","    return &composev1.ComposePsResponse{Services: response}, nil","}","","func (p *proxy) Stacks(ctx context.Context, request *composev1.ComposeListRequest) (*composev1.ComposeListResponse, error) {","    stacks, err := Client(ctx).ComposeService().List(ctx, request.ProjectName)","    if err != nil {","        return nil, err","    }","    response := []*composev1.Stack{}","    for _, stack := range stacks {","        response = append(response, &composev1.Stack{","            Id:     stack.ID,","            Name:   stack.Name,","            Status: stack.Status,","            Reason: stack.Reason,","        })","    }","    return &composev1.ComposeListResponse{Stacks: response}, nil","}","","func getComposeProject(files []string, workingDir string, projectName string) (*types.Project, error) {","    options, err := cli.NewProjectOptions(files, cli.WithWorkingDirectory(workingDir), cli.WithName(projectName))","    if err != nil {","        return nil, err","    }","    return cli.ProjectFromOptions(options)","}","func (p *proxy) Services(ctx context.Context, request *composev1.ComposeServicesRequest) (*composev1.ComposeServicesResponse, error) {","    return &composev1.ComposeServicesResponse{Services: response}, nil","func (p *proxy) Stacks(ctx context.Context, request *composev1.ComposeStacksRequest) (*composev1.ComposeStacksResponse, error) {","    return &composev1.ComposeStacksResponse{Stacks: response}, nil","    response := []*composev1.Service{}","    _, err := Client(ctx).ComposeService().Ps(ctx, projectName)","    /* FIXME need to create `docker service ls` command to re-introduce this feature","    }*/","    \"github.com/docker/compose-cli/api/compose\"","","    err = Client(ctx).ComposeService().Up(ctx, project, compose.UpOptions{Detach: true})","    return &composev1.ComposeUpResponse{ProjectName: project.Name}, err","    err := Client(ctx).ComposeService().Down(ctx, projectName, compose.DownOptions{})","    return &composev1.ComposeDownResponse{ProjectName: projectName}, err","            Id:              service.ID,","            ProjectName:     service.ProjectName,","            Replicas:        uint32(service.Replicas),","            Desired:         uint32(service.Desired),","            Ports:           service.Ports,","    composev1 \"github.com/docker/compose-cli/cli/server/protos/compose/v1\"","    stacks, err := Client(ctx).ComposeService().List(ctx)","    _, err := Client(ctx).ComposeService().Ps(ctx, projectName, compose.PsOptions{})","    stacks, err := Client(ctx).ComposeService().List(ctx, compose.ListOptions{All: request.All})"]}