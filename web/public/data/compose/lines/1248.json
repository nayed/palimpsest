i/types/container\"","    \"github.com/docker/compose/v5/internal/engine\"","// AttachContainers attaches to the containers of the selected services of the","// project, reporting their output to listener, and returns them.","func (s *Service) AttachContainers(ctx context.Context, project *types.Project, listener api.ContainerEventListener, selectedServices []string) ([]container.Summary, error) {","    containers, err := s.backend.Containers(ctx, project.Name, engine.OneOffExclude, true, selectedServices...)","    // This enforces predictable colors assignment","    sort.Slice(containers, func(i, j int) bool {","        return naming.CanonicalContainerName(containers[i]) < naming.CanonicalContainerName(containers[j])","    })","    _, err = fmt.Fprintf(s.backend.CLI().Out(), \"Attaching to %s\\n\", strings.Join(names, \", \"))","        err := s.AttachContainer(ctx, service, ctr.ID, naming.ContainerNameWithoutProject(ctr), listener)","// AttachContainer attaches to one container, reporting its output to listener.","func (s *Service) AttachContainer(ctx context.Context, service, id, name string, listener api.ContainerEventListener) error {","    inspected, err := s.backend.APIClient().ContainerInspect(ctx, id, client.ContainerInspectOptions{})","    err = s.attachContainerStreams(ctx, id, inspected.Container.Config.Tty, wOut, wErr)","func (s *Service) attachContainerStreams(ctx context.Context, containerID string, tty bool, stdout, stderr io.WriteCloser) error {","func (s *Service) getContainerStreams(ctx context.Context, containerID string) (io.ReadCloser, error) {","    attachResponse, err := s.backend.APIClient().ContainerAttach(ctx, containerID, client.ContainerAttachOptions{","        stdout := hijackedStdout{HijackedResponse: attachResponse.HijackedResponse}","    logs, err := s.backend.APIClient().ContainerLogs(ctx, containerID, client.ContainerLogsOptions{","","var _ io.ReadCloser = hijackedStdout{}","","// hijackedStdout implements ReadCloser for client.Hij