 := range allContainers.Items {","        containers = allContainers.Items","    volumesResponse, err := s.apiClient().VolumeList(ctx, client.VolumeListOptions{","        Filters: projectFilter(project),","    projectVolumes := volumesResponse.Items","    for _, ctr := range containers {","        for _, mount := range ctr.Mounts {","func (s *composeService) Volumes(ctx context.Context, projectName string, options api.VolumesOptions) ([]api.VolumesSummary, error) {","        Filters: projectFilter(projectName),","        for _, ctr := range allContainers.Items {","            if slices.Contains(options.Services, ctr.Labels[api.ServiceLabel]) {","                containers = append(containers, ctr)","        Filters: projectFilter(projectName),","package inspect","func (s *Service) Volumes(ctx context.Context, projectName string, options api.VolumesOptions) ([]api.VolumesSummary, error) {","    allContainers, err := s.backend.APIClient().ContainerList(ctx, client.ContainerListOptions{","    volumesResponse, err := s.backend.APIClient().VolumeList(ctx, client.VolumeListOptions{","    \"github.com/docker/compose/v5/internal/naming\"","        Filters: naming.ProjectFilter(projectName),","        Filters: naming.ProjectFilter(projectName),","        containers = naming.InServices(allContainers.Items, options.Services)"]}