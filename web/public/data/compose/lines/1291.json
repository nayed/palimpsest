.Flags()","    flags.BoolVar(&opts.wait, \"wait\", false, \"Wait for services to be running|healthy. Implies detached mode.\")","    flags.IntVar(&opts.waitTimeout, \"wait-timeout\", 0, \"Maximum duration in seconds to wait for the project to be running|healthy\")","","","    timeout := time.Duration(opts.waitTimeout) * time.Second","        AttachTo:    services,","        Project:     project,","        Services:    services,","        Wait:        opts.wait,","        WaitTimeout: timeout,","    \"github.com/spf13/cobra\"","","    var timeout time.Duration","    if opts.waitTimeout > 0 {","        timeout = time.Duration(opts.waitTimeout) * time.Second","    }","    return withBackend(ctx, dockerCli, backendOptions, func(backend api.Compose) error {","        return backend.Start(ctx, name, api.StartOptions{","            AttachTo:    services,","            Project:     project,","            Services:    services,","            Wait:        opts.wait,","            WaitTimeout: timeout,","        })","    return withBackend(dockerCli, backendOptions, func(backend api.Compose) error {","    // a label-reconstructed project (no compose file) declares no jobs;","    // with a file, refuse active scheduled jobs like up and create do","    if project != nil {","        if err := rejectScheduledJobs(project); err != nil {","            return err","        }","    }","        if jobErr, replaced := jobTargetErr(ctx, dockerCli, opts.ProjectOptions, services, err); replaced {","            return jobErr","        }","    \"fmt\"","        // with a file, refuse active scheduled jobs like up and create do","    } else if len(services) > 0 {","        // projectOrName falls back to this label-reconstructed, file-less","        // project (no error) when loading otherwise fails and","        // COMPOSE_PROJECT_NAME is set — swallowing a \"no such service\" for","        // a target that's actually a declared job along with it. Refuse it","        // explicitly here too: a