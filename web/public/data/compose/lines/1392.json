","            eg.Go(func() error {","                return s.restartContainer(ctx, project.Services[service], ctr, options)","            })","        }","        return eg.Wait()","    })","}","","// prepareRestartProject resolves the project restart applies to, restricted","// to the requested services and the depends_on relations with restart: true","func (s *composeService) prepareRestartProject(ctx context.Context, containers Containers, projectName string, options api.RestartOptions) (*types.Project, error) {","    var err error","            return nil, err","            return nil, err","        return nil, err","            return nil, err","    return project, nil","}","// restartContainer restarts a container, running its pre_stop and post_start","// hooks around the restart","func (s *composeService) restartContainer(ctx context.Context, def types.ServiceConfig, ctr container.Summary, options api.RestartOptions) error {","    for _, hook := range def.PreStop {","        err := s.runHook(ctx, ctr, def, hook, nil)","    }","    eventName := getContainerProgressName(ctr)","    s.events.On(newEvent(eventName, api.Working, api.StatusRestarting))","    _, err := s.apiClient().ContainerRestart(ctx, ctr.ID, client.ContainerRestartOptions{","        Timeout: utils.DurationSecondToInt(options.Timeout),","    if err != nil {","        return err","    }","    s.events.On(newEvent(eventName, api.Done, api.StatusStarted))","    for _, hook := range def.PostStart {","        err := s.runHook(ctx, ctr, def, hook, nil)","        if err != nil {","            return err","        }","    }","    return nil","// hooks around the restart — except for a relay, a shell-less scratch binary","// standing in for the service: it has no process for a hook to act on.","    relay := isRelayContainer(ctr)","    if !relay {","        for _, hook := range def.PreStop {","            err := s.runHook(ctx, ctr, def, hook, nil)","            if err != nil {","                return err","            }","    if !relay {","        for _, hook := range def.PostStart {","            err := s.runHook(ctx, ctr, def, hook, nil)","            if err != nil {","                return err","            }","        eg, ctx := newLimitedErrgroup(ctx, s.maxConcurrency)","    \"golang.org/x/sync/errgroup\"","    // shared by every service so the dependency-order fan-out and the","    // per-service container fan-out combined never exceed maxConcurrency","    // concurrent per-container restarts (pre_stop hook, ContainerRestart,","    // post_start hook) — a per-service bound alone allows as many","    // independent services to run at once as the graph permits, each with","    // its own maxConcurrency budget","    limiter := newOptionalLimiter(s.maxConcurrency)","","        eg, ctx := errgroup.WithContext(ctx)","                if err := acquireSlot(ctx, limiter); err != nil {","                    return err","                }","                defer releaseSlot(limiter)","        return forEachContainerWithLimiter(ctx, limiter, containers.filter(isService(service)), func(ctx context.Context, ctr container.Summary) error {","            return s.restartContainer(ctx, project.Services[service], ctr, options)","        })","        return forEachWithLimiter(ctx, limiter, containers.filter(isService(service)), func(ctx context.Context, ctr container.Summary) error {","        err := s.waitDependencies(ctx, project, service, config.DependsOn, containers)","    \"github.com/docker/compose/v5/internal/concurrency\"","    limiter := concurrency.NewLimiter(s.maxConcurrency)","        return concurrency.ForEach(ctx, limiter, containers.filter(isService(service)), func(ctx context.Context, ctr container.Summary) error {","    \"github.com/docker/compose/v5/internal/progress\"","    s.events.On(progress.New(eventName, api.Working, api.StatusRestarting))","    s.events.On(progress.New(eventName, api.Done, api.StatusStarted))","    project, err := s.projectOrFromResources(ctx, options.Project, containers, projectName)","    if err != nil {","        return nil, err","    \"github.com/docker/compose/v5/internal/depgraph\"","    return depgraph.InDependencyOrder(ctx, project, func(c context.Context, service string) error {"]}