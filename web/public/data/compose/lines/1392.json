pes.Project, options api.RestartOptions) error {","    \"golang.org/x/sync/errgroup\"","    observedState, err := s.getContainers(ctx, project.Name, oneOffInclude, true)","    w := progress.ContextWriter(ctx)","    err = InDependencyOrder(ctx, project, func(c context.Context, service string) error {","        if !utils.StringContains(options.Services, service) {","            return nil","        eg, ctx := errgroup.WithContext(ctx)","        for _, c := range observedState.filter(isService(service)) {","            container := c","            eg.Go(func() error {","                eventName := getContainerProgressName(container)","                w.Event(progress.RestartingEvent(eventName))","                err := s.apiClient.ContainerRestart(ctx, container.ID, options.Timeout)","                if err == nil {","                    w.Event(progress.StartedEvent(eventName))","                }","                return err","            })","        }","        return eg.Wait()","        for _, container := range observedState.filter(isService(service)) {","            container := container","    \"github.com/docker/compose/v2/pkg/api\"","    \"github.com/docker/compose/v2/pkg/progress\"","    \"github.com/docker/compose/v2/pkg/utils\"","func (s *composeService) Restart(ctx context.Context, projectName string, options api.RestartOptions) error {","        return s.restart(ctx, projectName, options)","func (s *composeService) restart(ctx context.Context, projectName string, options api.RestartOptions) error {","","    observedState, err := s.getContainers(ctx, projectName, oneOffInclude, true)","    if err != nil {","        return err","    }","","    project, err := s.projectFromName(observedState, projectName, options.Services...)","                err := s.apiClient().ContainerRestart(ctx, container.ID, options.Timeout)","    \"strings\"","        return s.restart(ctx, strings.ToLower(projectName), options)","    observedState, err := s.getContainers(ctx, projectName, oneOffExclude, true)","    containers, err := s.getContainers(ctx, projectName, oneOffExclude, true)","    project := options.Project","    if project == nil {","        project, err = s.getProjectWithResources(ctx, containers, projectName)","        if err != nil {","            return err","        }","    return InDependencyOrder(ctx, project, func(c context.Context, service string) error {","        for _, container := range containers.filter(isService(service)) {","    containerType \"github.com/docker/docker/api/types/container\"","    \"golang.org/x/sync/errgroup\"","                timeout := utils.DurationSecondToInt(options.Timeout)","                err := s.apiClient().ContainerRestart(ctx, container.ID, containerType.StopOptions{Timeout: timeout})","        err = project.ForServices(options.Services)","        if err != nil {","            return err","        }","    // ignore depends_on relations which are not impacted by restarting service","    for i, service := range project.Services {","        for name, r := range service.DependsOn {","            if !r.Restart {","                delete(service.DependsOn, name)","            }","        }","        project.Services[i] = service","    }","","    \"github.com/compose-spec/compose-go/types\"","    if len(options.Services) != 0 {","        err = project.ForServices(options.Services, types.IncludeDependents)","    }, s.stderr())","    return progress.RunWithTitle(ctx, func(ctx context.Context) error {","    }, s.stderr(), \"Restarting\")","    }, s.stdinfo(), \"Restarting\")","    // ignore depends_on relations which are not impacted by restarting service or not required","    if options.NoDeps {","        err := project.ForServices(options.Services, types.IgnoreDependencies)","        if err != nil {","            return err","        }","    }","","    \"github.com/compose-spec/compose-go/v2/types\"","        project, err = project.WithSelectedServices(options.Services, types.IgnoreDependencies)","        project, err = project.WithSelectedServices(options.Services, types.IncludeDependents)","    project, err = project.WithServicesTransform(func(name string, s types.ServiceConfig) (types.ServiceConfig, error) {","        for name, r := range s.DependsOn {","                delete(s.DependsOn, name)","        return s, nil","    })","    if err != nil {","        return err","        for _, ctr := range containers.filter(isService(service)) {","                eventName := getContainerProgressName(ctr)","                err := s.apiClient().ContainerRestart(ctx, ctr.ID, containerType.StopOptions{Timeout: timeout})","                if err != nil {","                    return err","                w.Event(progress.StartedEvent(eventName))","                return nil","    \"github.com/docker/docker/api/types/container\"","    project, err = project.WithServicesTransform(func(_ string, s types.ServiceConfig) (types.ServiceConfig, error) {","                err := s.apiClient().ContainerRestart(ctx, ctr.ID, container.StopOptions{Timeout: timeout})","        config := project.Services[service]","        err = s.waitDependencies(ctx, project, service, config.DependsOn, containers, 0)","        if err != nil {","            return err","        }","","                err = s.apiClient().ContainerRestart(ctx, ctr.ID, container.StopOptions{Timeout: timeout})","func (s *composeService) restart(ctx context.Context, projectName string, options api.RestartOptions) error { //nolint:gocyclo","                def := project.Services[service]","                for _, hook := range def.PreStop {","                    err = s.runHook(ctx, ctr, def, hook, nil)","                    if err != nil {","                        return err","                    }","                }","                for _, hook := range def.PostStart {","                    err = s.runHook(ctx, ctr, def, hook, nil)","                    if err != nil {","                        return err"