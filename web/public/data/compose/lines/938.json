s\\t%s\\n\"","","        fmt.Fprintf(w,","            format,","            contextName,","            c.Metadata.Type,","            c.Metadata.Description,","            getEndpoint(\"docker\", c.Endpoints),","            getEndpoint(\"kubernetes\", c.Endpoints),","            c.Metadata.StackOrchestrator)","","func getEndpoint(name string, meta map[string]store.Endpoint) string {","    d, ok := meta[name]","    if !ok {","        return \"\"","    }","","    result := d.Host","    if d.DefaultNamespace != \"\" {","        result += fmt.Sprintf(\" (%s)\", d.DefaultNamespace)","    }","","    return result","}","            c.Type,","func getEndpoint(name string, meta map[string]interface{}) string {","    endpoints, ok := meta[name]","    if !ok {","        return \"\"","    }","    data, ok := endpoints.(store.Endpoint)","    result := data.Host","    if data.DefaultNamespace != \"\" {","        result += fmt.Sprintf(\" (%s)\", data.DefaultNamespace)","            c.Type(),","    fmt.Fprintln(w, \"NAME\\tTYPE\\tDESCRIPTION\\tDOCKER ENDPOINT\\tKUBERNETES ENDPOINT\\tORCHESTRATOR\")","    data, ok := endpoints.(*store.Endpoint)","type lsOpts struct {","    quiet bool","}","","    var opts lsOpts","            return runList(cmd.Context(), opts)","    cmd.Flags().BoolVarP(&opts.quiet, \"quiet\", \"q\", false, \"Only show context names\")","func runList(ctx context.Context, opts lsOpts) error {","    if opts.quiet {","        for _, c := range contexts {","            fmt.Println(c.Name)","        }","        return nil","    }","","    \"errors\"","    \"github.com/docker/api/formatter\"","    json  bool","}","","func (o lsOpts) validate() error {","    if o.quiet && o.json {","        return errors.New(`cannot combine \"quiet\" and \"json\" options`)","    }","    return nil","    cmd.Flags().BoolVar(&opts.json, \"json\", false, \"Format output as JSON\")","","    err := opts.validate()","    if err != nil {","        return err","    }","","    if opts.json {","   