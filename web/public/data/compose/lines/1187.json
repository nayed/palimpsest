d, *containerGroup.Name)","        }","    }","    return deleted, multierr.ErrorOrNil()","}","    \"fmt\"","func (cs *aciResourceService) Prune(ctx context.Context, request resources.PruneRequest) (resources.PruneResult, error) {","    result := resources.PruneResult{}","        return result, err","    cpus := 0.","    mem := 0.","","        for _, container := range *containerGroup.Containers {","            hostConfig := convert.ToHostConfig(container, containerGroup)","            cpus += hostConfig.CPUReservation","            mem += convert.BytesToGB(float64(hostConfig.MemoryReservation))","        }","","    result.DeletedIDs = deleted","    result.Summary = fmt.Sprintf(\"Total CPUs reclaimed: %.2f, total memory reclaimed: %.2f GB\", cpus, mem)","    return result, multierr.ErrorOrNil()","","        deleted = append(deleted, *containerGroup.Name)","    \"github.com/docker/compose-cli/api/context/store\""]}