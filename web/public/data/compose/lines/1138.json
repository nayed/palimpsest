for _, vol := range volumes {","            _, _ = fmt.Fprintf(w, \"%s\\t%s\\n\", vol.ID, vol.Description)","        }","    }, \"ID\", \"DESCRIPTION\")","}","","func printSection(out io.Writer, printer func(io.Writer), headers ...string) {","    w := tabwriter.NewWriter(out, 20, 1, 3, ' ', 0)","    _, _ = fmt.Fprintln(w, strings.Join(headers, \"\\t\"))","    printer(w)","    _ = w.Flush()","}","   Copyright 2020 Docker Compose CLI authors","    \"github.com/docker/compose-cli/formatter\"","type listVolumeOpts struct {","    format string","}","","    var opts listVolumeOpts","            view := viewFromVolumeList(vols)","            return formatter.Print(view, opts.format, os.Stdout, func(w io.Writer) {","                for _, vol := range view {","                    _, _ = fmt.Fprintf(w, \"%s\\t%s\\n\", vol.ID, vol.Description)","                }","            }, \"ID\", \"DESCRIPTION\")","    cmd.Flags().StringVar(&opts.format, \"format\", formatter.PRETTY, \"Format the output. Values: [pretty | json]. (Default: pretty)\")","type volumeView struct {","    ID          string","    Description string","func viewFromVolumeList(volumeList []volumes.Volume) []volumeView {","    retList := make([]volumeView, len(volumeList))","    for i, v := range volumeList {","        retList[i] = volumeView{","            ID:          v.ID,","            Description: v.Description,","        }","    }","    return retList","    quiet  bool","            if opts.quiet {","                for _, v := range vols {","                    fmt.Println(v.ID)","                }","                return nil","            }","    cmd.Flags().BoolVarP(&opts.quiet, \"quiet\", \"q\", false, \"Only display IDs\")","    \"github.com/docker/compose-cli/cli/formatter\"","    formatter2 \"github.com/docker/compose-cli/cmd/formatter\"","","            return formatter2.Print(view, opts.format, os.Stdout, func(w io.Writer) {","    cmd.Flags().StringVar(&opts.format, \"format\", formatter2.PRETTY, \"Format the output. Values: [pretty | json]. (Default: pretty)\")"]}