"","    c.RunDockerComposeCmd(t, \"-f\", \"./fixtures/wait/compose.yaml\", \"--project-name\", projectName, \"up\", \"-d\")","","    finished := make(chan struct{})","    ticker := time.NewTicker(7 * time.Second)","    go func() {","        c.RunDockerComposeCmd(t, \"--project-name\", projectName, \"wait\", \"infinity\")","        finished <- struct{}{}","    }()","","    select {","    case <-finished:","        t.Fatal(\"wait infinity should not finish\")","    case <-ticker.C:","    }","}","","func TestWaitAndDrop(t *testing.T) {","    const projectName = \"e2e-wait-and-drop\"","    c := NewParallelCLI(t)","","    c.RunDockerComposeCmd(t, \"-f\", \"./fixtures/wait/compose.yaml\", \"--project-name\", projectName, \"up\", \"-d\")","    c.RunDockerComposeCmd(t, \"--project-name\", projectName, \"wait\", \"--down-project\", \"faster\")","","    res := c.RunDockerCmd(t, \"ps\", \"--all\")","    assert.Assert(t, !strings.Contains(res.Combined(), projectName), res.Combined())","}","    \"gotest.tools/v3/icmd\"","","    cleanup := func() {","        c.RunDockerComposeCmd(t, \"--project-name\", projectName, \"down\", \"--timeout=0\", \"--remove-orphans\")","    }","    t.Cleanup(cleanup)","    cleanup()","","    cleanup := func() {","        c.RunDockerComposeCmd(t, \"--project-name\", projectName, \"down\", \"--timeout=0\", \"--remove-orphans\")","    }","    t.Cleanup(cleanup)","    cleanup()","","    cleanup := func() {","        c.RunDockerComposeCmd(t, \"--project-name\", projectName, \"down\", \"--timeout=0\", \"--remove-orphans\")","    }","    t.Cleanup(cleanup)","    cleanup()","","    cmd := c.NewDockerComposeCmd(t, \"--project-name\", projectName, \"wait\", \"infinity\")","    r := icmd.StartCmd(cmd)","    assert.NilError(t, r.Error)","    t.Cleanup(func() {","        if r.Cmd.Process != nil {","            _ = r.Cmd.Process.Kill()","        }","    })","","        _ = r.Cmd.Wait()","    cleanup := func() {","        c.RunDockerComposeCmd(t, \"--project-name\", projectName, \"down\", \"--timeout=0\", \"--remove-orphans\")","    }","    t.Cleanup(cleanup)","    cleanup()","","    \"gotest.tools/v3/icmd\"","    NewScenario(t, \"wait must return once the selected service exits, whatever the others do\").","        Step(\"up starts all services\",","            ComposeCmd(\"up\", \"-d\")).","        Step(\"wait returns when the fastest service exits\",","            ComposeCmd(\"wait\", \"faster\"),","            ServiceState(\"faster\", \"exited\"),","            ServiceState(\"infinity\", \"running\"))","    NewScenario(t, \"wait must block until the selected service exits, even if others exited first\").","        Step(\"up starts all services\",","            ComposeCmd(\"up\", \"-d\")).","        Step(\"wait returns when the slower service exits\",","            ComposeCmd(\"wait\", \"slower\"),","            ServiceState(\"faster\", \"exited\"),","            ServiceState(\"slower\", \"exited\"),","            ServiceState(\"infinity\", \"running\"))","    NewScenario(t, \"wait --down-project must take the whole project down once the selected service exits\").","        Step(\"up starts all services\",","            ComposeCmd(\"up\", \"-d\")).","        Step(\"wait --down-project removes every container when the service exits\",","            ComposeCmd(\"wait\", \"--down-project\", \"faster\"),","            ServiceNotCreated(\"faster\"),","            ServiceNotCreated(\"slower\"),","            ServiceNotCreated(\"infinity\"))","//go:build e2e",""]}