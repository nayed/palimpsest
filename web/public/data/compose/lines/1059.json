 projectName, err := opts.toProjectName()","    return c.ComposeService().Logs(ctx, projectName, os.Stdout)","    \"github.com/docker/compose-cli/api/client\"","   Copyright 2020 Docker Compose CLI authors","    c, err := client.NewWithDefaultLocalBackend(ctx)","    \"github.com/docker/compose-cli/formatter\"","","    \"github.com/spf13/cobra\"","    consumer := formatter.NewLogConsumer(ctx, os.Stdout)","    return c.ComposeService().Logs(ctx, projectName, consumer)","        Use:   \"logs\",","        Short: \"View output from containers\",","    \"github.com/docker/compose-cli/api/compose\"","        Use:   \"logs [service...]\",","            return runLogs(cmd.Context(), opts, args)","func runLogs(ctx context.Context, opts composeOptions, services []string) error {","    return c.ComposeService().Logs(ctx, projectName, consumer, compose.LogOptions{","        Services: services,","    })","    \"github.com/spf13/cobra\"","","    logsCmd.Flags().StringVarP(&opts.ProjectName, \"project-name\", \"p\", \"\", \"Project name\")","    \"github.com/docker/compose-cli/cli/formatter\"","type logsOptions struct {","    *projectOptions","    composeOptions","}","","func logsCommand(p *projectOptions) *cobra.Command {","    opts := logsOptions{","        projectOptions: p,","    }","func runLogs(ctx context.Context, opts logsOptions, services []string) error {","    \"github.com/docker/compose-cli/api/context/store\"","    follow bool","    tail   string","func logsCommand(p *projectOptions, contextType string) *cobra.Command {","    logsCmd.Flags().BoolVar(&opts.follow, \"follow\", false, \"Follow log output.\")","    if contextType == store.DefaultContextType {","        logsCmd.Flags().StringVar(&opts.tail, \"tail\", \"all\", \"Number of lines to show from the end of the logs for each container.\")","    }","        Follow:   opts.follow,","        Tail:     opts.tail,","    follow   bool","    tail     string","    noColor  bool","    noPrefix bool","    flags := logsCmd.