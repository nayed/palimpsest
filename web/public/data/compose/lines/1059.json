lative (e.g. 42m for 42 minutes)\")","        Since:      opts.since,","        Until:      opts.until,","        Use:   \"logs [SERVICE...]\",","        ValidArgsFunction: serviceCompletion(p),","    \"github.com/docker/compose-cli/cmd/formatter\"","","func logsCommand(p *projectOptions, backend api.Service) *cobra.Command {","    flags.StringVar(&opts.tail, \"tail\", \"all\", \"Number of lines to show from the end of the logs for each container.\")","    \"github.com/docker/compose/v2/cmd/formatter\"","    \"github.com/docker/compose/v2/pkg/api\"","        Use:   \"logs [OPTIONS] [SERVICE...]\",","    project, name, err := opts.projectOrName()","    return backend.Logs(ctx, name, consumer, api.LogOptions{","        Project:    project,","        ValidArgsFunction: completeServiceNames(p),","    project, name, err := opts.projectOrName(services...)","    consumer := formatter.NewLogConsumer(ctx, os.Stdout, os.Stderr, !opts.noColor, !opts.noPrefix)","    \"github.com/docker/compose/v2/cmd/formatter\"","    consumer := formatter.NewLogConsumer(ctx, os.Stdout, os.Stderr, !opts.noColor, !opts.noPrefix, false)","    *ProjectOptions","func logsCommand(p *ProjectOptions, backend api.Service) *cobra.Command {","        ProjectOptions: p,","func logsCommand(p *ProjectOptions, streams api.Streams, backend api.Service) *cobra.Command {","            return runLogs(ctx, streams, backend, opts, args)","func runLogs(ctx context.Context, streams api.Streams, backend api.Service, opts logsOptions, services []string) error {","    consumer := formatter.NewLogConsumer(ctx, streams.Out(), streams.Err(), !opts.noColor, !opts.noPrefix, false)","    flags.StringVarP(&opts.tail, \"tail\", \"n\", \"all\", \"Number of lines to show from the end of the logs for each container.\")","    \"github.com/docker/cli/cli/command\"","func logsCommand(p *ProjectOptions, dockerCli command.Cli, backend api.Service) *cobra.Command {","            return runLogs(ctx, dockerCli, backend, opts, args)","        ValidArgsFunction: completeServiceNames(dockerCli, p),","func runLogs(ctx context.Context, dockerCli command.Cli, backend api.Service, opts logsOptions, services []string) error {","    project, name, err := opts.projectOrName(dockerCli, services...)","    consumer := formatter.NewLogConsumer(ctx, dockerCli.Out(), dockerCli.Err(), !opts.noColor, !opts.noPrefix, false)","    index      int","    flags.IntVar(&opts.index, \"index\", 1, \"index of the container if there are multiple instances of a service [default: 1].\")","    \"errors\"","        PreRunE: func(cmd *cobra.Command, args []string) error {","            if opts.index > 0 && len(args) != 1 {","                return errors.New(\"--index requires one service to be selected\")","            }","            return nil","        },","    flags.IntVar(&opts.index, \"index\", 0, \"index of the container if service has multiple replicas\")","        Index:      opts.index,","    project, name, err := opts.projectOrName(ctx, dockerCli, services...)","    flags.BoolVarP(&opts.follow, \"follow\", \"f\", false, \"Follow log output\")","    flags.BoolVar(&opts.noColor, \"no-color\", false, \"Produce monochrome output\")","    flags.BoolVar(&opts.noPrefix, \"no-log-prefix\", false, \"Don't print prefix in logs\")","    flags.BoolVarP(&opts.timestamps, \"timestamps\", \"t\", false, \"Show timestamps\")","    flags.StringVarP(&opts.tail, \"tail\", \"n\", \"all\", \"Number of lines to show from the end of the logs for each container\")","","    // exclude services configured to ignore output (attach: false), until explicitly selected","    if project != nil && len(services) == 0 {","        for n, service := range project.Services {","            if service.Attach == nil || *service.Attach {","                services = append(services, n)","            }","        }","    }","","func logsCommand(p *ProjectOptions, dockerCli command.Cli, backend api.Compose) *cobra.Command {","func runLogs(ctx context.Context, dockerCli command.Cli, backend api.Compose, opts logsOptions, services []string) error {","    \"github.com/docker/compose/v2/pkg/compose\"","func logsCommand(p *ProjectOptions, dockerCli command.Cli, backendOptions *BackendOptions) *cobra.Command {","            return runLogs(ctx, dockerCli, backendOptions, opts, args)","func runLogs(ctx context.Context, dockerCli command.Cli, backendOptions *BackendOptions, opts logsOptions, services []string) error {","    backend, err := compose.NewComposeService(dockerCli, backendOptions.Options...)","    if err != nil {","        return err","    }","    outStream, errStream, _ := backend.GetConfiguredStreams()","    consumer := formatter.NewLogConsumer(ctx, outStream, errStream, !opts.noColor, !opts.noPrefix, false)","    \"github.com/docker/compose/v2/pkg/progress\"","    consumer := formatter.NewLogConsumer(ctx, dockerCli.Out(), dockerCli.Err(), !opts.noColor, !opts.noPrefix, false)","","var _ api.LogConsumer = &logConsumer{}","","type logConsumer struct {","    events progress.EventProcessor","}","","func (l logConsumer) Log(containerName, message string) {","    l.events.On(progress.Event{","        ID:   containerName,","        Text: message,","    })","}","","func (l logConsumer) Err(containerName, message string) {","    l.events.On(progress.Event{","        ID:     containerName,","        Status: progress.Error,","        Text:   message,","    })","}","","func (l logConsumer) Status(containerName, message string) {","    l.events.On(progress.Event{","        ID:     containerName,","        Status: progress.Error,","        Text:   message,","    })","}","    events api.EventProcessor","    l.events.On(api.Resource{","    l.events.On(api.Resource{","        Status: api.Error,","    l.events.On(api.Resource{","        Status: api.Error,","    \"github.com/docker/compose/v5/pkg/compose\"","    \"github.com/docker/compose/v5/cmd/formatter\"","    \"github.com/docker/compose/v5/pkg/api\"","    \"github.com/docker/compose/v5/pkg/compose\"","    \"github.com/docker/cli-docs-tool/annotation\"","    flags.SetAnnotation(\"since\", annotation.ExternalURL, []string{\"https://docs.docker.com/reference/cli/docker/container/logs/\"}) //nolint:errcheck","    flags.SetAnnotation(\"until\", annotation.ExternalURL, []string{\"https://docs.docker.com/reference/cli/docker/container/logs/#until\"}) //nolint:errcheck","    flags.SetAnnotation(\"follow\", annotation.ExternalURL, []string{\"https://docs.docker.com/reference/cli/docker/container/logs/#follow\"}) //nolint:errcheck","    flags.SetAnnotation(\"since\", annotation.ExternalURL, []string{\"https://docs.docker.com/reference/cli/docker/container/logs/#since\"}) //nolint:errcheck","    flags.SetAnnotation(\"timestamps\", annotation.ExternalURL, []string{\"https://docs.docker.com/reference/cli/docker/container/logs/#timestamps\"}) //nolint:errcheck","    flags.SetAnnotation(\"tail\", annotation.ExternalURL, []string{\"https://docs.docker.com/reference/cli/docker/container/logs/#tail\"}) //nolint:errcheck"]}