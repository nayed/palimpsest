{"format":"palimpsest-lines","version":1,"file":2179,"commits":[3531,3541,3670,3770,3897,3898,3899,3911],"opsStart":[0,2,16,20,24,28,32,36,68],"ops":[2,28,0,18,2,1,0,1,3,1,2,2,0,1,2,23,0,17,3,1,0,17,3,1,0,18,3,1,0,17,3,1,0,17,3,1,0,17,2,5,0,1,2,1,0,2,2,3,0,2,3,1,2,1,0,1,2,1,0,23,2,1,0,1,3,1,2,1],"texts":["# syntax=docker/dockerfile:1","","","#   Copyright 2020 Docker Compose CLI authors","","#   Licensed under the Apache License, Version 2.0 (the \"License\");","#   you may not use this file except in compliance with the License.","#   You may obtain a copy of the License at","","#       http://www.apache.org/licenses/LICENSE-2.0","","#   Unless required by applicable law or agreed to in writing, software","#   distributed under the License is distributed on an \"AS IS\" BASIS,","#   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.","#   See the License for the specific language governing permissions and","#   limitations under the License.","","ARG GO_VERSION=1.26.8","","FROM golang:${GO_VERSION}-alpine AS build","WORKDIR /src","COPY go.mod main.go ./","RUN CGO_ENABLED=0 go build -trimpath -ldflags=\"-w -s\" -o /compose-relay .","","FROM scratch","COPY --from=build /compose-relay /compose-relay","USER 65532:65532","ENTRYPOINT [\"/compose-relay\"]","ARG GOLANGCI_LINT_VERSION=v2.13.2","FROM golangci/golangci-lint:${GOLANGCI_LINT_VERSION}-alpine AS golangci-lint","","FROM golang:${GO_VERSION}-alpine AS base","","FROM base AS build-base","COPY go.mod ./","RUN --mount=type=cache,target=/go/pkg/mod \\","    go mod download","","FROM build-base AS lint","ENV GOLANGCI_LINT_CACHE=/cache/golangci-lint","RUN --mount=type=bind,target=. \\","    --mount=type=cache,target=/root/.cache \\","    --mount=type=cache,target=/go/pkg/mod \\","    --mount=type=cache,target=/cache/golangci-lint \\","    --mount=from=golangci-lint,source=/usr/bin/golangci-lint,target=/usr/bin/golangci-lint \\","    golangci-lint run ./...","","FROM build-base AS test","RUN --mount=type=bind,target=. \\","    --mount=type=cache,target=/root/.cache \\","    --mount=type=cache,target=/go/pkg/mod \\","    go vet ./... && \\","    go test -v ./...","","FROM base AS build","ARG GO_VERSION=1.26.9","ARG GO_VERSION=1.26.10","ARG GOLANGCI_LINT_VERSION=v2.15.0","ARG GO_VERSION=1.27.3","ARG GO_VERSION=1.27.4","# Keep the versions below in sync with the Dockerfile at the root: the relay is","# built the way the compose binary is, on the build platform, cross-compiled","# for the target with xx. A golang image per target platform does not scale: the","# alpine tags do not carry every platform the relay ships for (riscv64 is","# missing from golang:1.27-alpine).","ARG XX_VERSION=1.9.0","# xx is a helper for cross-compilation","FROM --platform=${BUILDPLATFORM} tonistiigi/xx:${XX_VERSION} AS xx","","FROM --platform=${BUILDPLATFORM} golang:${GO_VERSION}-alpine3.23 AS base","COPY --from=xx / /","ENV CGO_ENABLED=0","ARG TARGETPLATFORM","RUN xx-go build -trimpath -ldflags=\"-w -s\" -o /compose-relay . && \\","    xx-verify --static /compose-relay"]}