     if replica, exists := ctr.Labels[api.ContainerNumberLabel]; exists {","                s.Replica = replica","            }","            summary[i] = s","    \"github.com/docker/compose/v5/pkg/api\"","","    \"github.com/docker/compose/v5/pkg/api\"","    \"github.com/moby/moby/client\"","            topContent, err := s.apiClient().ContainerTop(ctx, ctr.ID, client.ContainerTopOptions{","                Arguments: []string{},","            })","    eg, ctx := newLimitedErrgroup(ctx, s.maxConcurrency)","package inspect","func (s *Service) Top(ctx context.Context, projectName string, services []string) ([]api.ContainerProcSummary, error) {","    containers, err := s.backend.Containers(ctx, projectName, OneOffInclude, false)","        containers = inServices(containers, services)","    eg, ctx := limitedGroup(ctx, s.backend.MaxConcurrency())","            topContent, err := s.backend.APIClient().ContainerTop(ctx, ctr.ID, client.ContainerTopOptions{","            name := canonicalContainerName(ctr)","    \"github.com/docker/compose/v5/internal/naming\"","            name := naming.CanonicalContainerName(ctr)","    \"github.com/docker/compose/v5/internal/concurrency\"","    eg, ctx := concurrency.NewErrgroup(ctx, s.backend.MaxConcurrency())","    \"github.com/docker/compose/v5/internal/engine\"","    containers, err := s.backend.Containers(ctx, projectName, engine.OneOffInclude, false)","        containers = naming.InServices(containers, services)"]}