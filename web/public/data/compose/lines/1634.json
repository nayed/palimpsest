ync.WaitGroup","        errMu sync.Mutex","        errs  = make([]error, 0, len(m.exporters))","    )","","    for _, exporter := range m.exporters {","        wg.Add(1)","        go func() {","            defer wg.Done()","            if err := exporter.ExportSpans(ctx, spans); err != nil {","                errMu.Lock()","                errs = append(errs, err)","                errMu.Unlock()","            }","        }()","    wg.Wait()","    return errors.Join(errs...)","    var (","        wg    sync.WaitGroup","        errMu sync.Mutex","        errs  = make([]error, 0, len(m.exporters))","    )","","    for _, exporter := range m.exporters {","        wg.Add(1)","        go func() {","            defer wg.Done()","            if err := exporter.Shutdown(ctx); err != nil {","                errMu.Lock()","                errs = append(errs, err)","                errMu.Unlock()","            }","        }()","    wg.Wait()","    return errors.Join(errs...)","        wg.Go(func() {","        })","        wg.Go(func() {","        })"]}