,"        newValues := groupResponse.Values()","        groups = append(groups, newValues...)","    }","","    DeleteAsync(ctx context.Context, subscriptionID string, resourceGroupName string) error","// DeleteAsync deletes a resource group. Does not wait for full deletion to return (long operation)","func (mgt aciResourceGroupHelperImpl) DeleteAsync(ctx context.Context, subscriptionID string, resourceGroupName string) (err error) {","    _, err = gc.Delete(ctx, resourceGroupName)","    return err","        return subscription.SubscriptionsClient{}, errors.Wrap(errdefs.ErrLoginRequired, err.Error())","package aci","// ResourceGroupHelper interface to manage resource groups and subscription IDs","type ResourceGroupHelper interface {","// NewACIResourceGroupHelper create a new ResourceGroupHelper","func NewACIResourceGroupHelper() ResourceGroupHelper {","    \"github.com/docker/api/aci/login\"","    gc, err := login.NewGroupsClient(subscriptionID)","    gc, err := login.NewGroupsClient(subscriptionID)","    gc, err := login.NewGroupsClient(subscriptionID)","    gc, err := login.NewGroupsClient(subscriptionID)","    c, err := login.NewSubscriptionsClient()","    \"github.com/docker/compose-cli/aci/login\"","   Copyright 2020 Docker Compose CLI authors"]}